---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import gustoMedals from "../../assets/img/awards/gusto-innovation-golden-metals.png";
import gustoProjectDisplay from "../../assets/img/awards/polo-gusto-innovation-1.jpeg";

interface Recognition {
  result: string;
  event: string;
  datetime: string;
  date: string;
}

const recognitions: Recognition[] = [
  {
    result: "Winner Nominee",
    event: "UXMM AI Ocean",
    datetime: "2026-11",
    date: "November 2026",
  },
  {
    result: "First runner-up",
    event: "GUSTO Innovation Awards & Forum 2026",
    datetime: "2026-08",
    date: "August 2026",
  },
  {
    result: "Winner",
    event: "Let's Tech 2026: Agentic Edition",
    datetime: "2026-07",
    date: "July 2026",
  },
  {
    result: "Winner",
    event: "GUSTO Technical Competition 2026",
    datetime: "2026-01",
    date: "January 2026",
  },
];

const photos = [
  {
    src: gustoProjectDisplay,
    alt: "The team's secured recommerce marketplace display at the GUSTO Innovation Awards & Forum",
    caption: "The team's recommerce marketplace display, GUSTO Innovation Awards & Forum, August 2026",
  },
  {
    src: gustoMedals,
    alt: "Two gold GUSTO College award medals held in one hand",
    caption: "Two gold medals from the GUSTO Innovation Awards & Forum, August 2026",
  },
];

const largePhotos = await Promise.all(
  photos.map(async (photo) => {
    const large = await getImage({ src: photo.src, width: 1400, format: "webp" });
    return { src: large.src, width: large.options.width, height: large.options.height, alt: photo.alt, caption: photo.caption };
  }),
);
---

<!-- Events and outcomes stay distinct; the adjacent photographs document the GUSTO forum. -->
<section id="recognition" aria-labelledby="recognition-heading" class="scroll-mt-[calc(var(--section-gap-l)*-1)] pt-(--section-gap-l)">
  <h2 data-spring-reveal
    id="recognition-heading"
    class="text-section font-semibold leading-[1.02] tracking-[-0.04em] text-(--text-heading)"
  >
    Competition results
  </h2>

  <p class="mt-4 max-w-lg text-base leading-relaxed text-(--text-muted)" data-spring-reveal>From technical competitions to innovation awards.</p>

  <div class="recognition-split mt-10">
    <div class="recognition-ledger">
      <ul class="recognition-list" role="list">
        {recognitions.map((recognition) => (
          <li class="recognition-row" data-spring-reveal>
            <p class="recognition-result" data-winner={recognition.result === "Winner" ? "true" : undefined}><Icon name={recognition.result === "Winner" ? "lucide:trophy" : "lucide:award"} class="size-3.5" aria-hidden="true" />{recognition.result}</p>
            <p class="recognition-event">{recognition.event}</p>
            <time datetime={recognition.datetime} class="recognition-date text-sm tabular-nums text-(--text-faint)">
              {recognition.date}
            </time>
          </li>
        ))}
      </ul>
    </div>

    <div class="recognition-gallery" data-spring-reveal>
    <div class="recognition-photos">
      <figure class="recognition-photo recognition-photo--lead">
        <a href={largePhotos[0].src} class="photo-open" data-spring-card data-photo-index="0" aria-label={`View larger: ${photos[0].alt}`}>
        <Image
          src={gustoProjectDisplay}
          alt="The team's secured recommerce marketplace display at the GUSTO Innovation Awards & Forum"
          width={700}
          widths={[400, 600, 700]}
          quality={70}
          sizes="(min-width: 1024px) 330px, min(57vw, 286px)"
          loading="lazy"
          class="h-full w-full object-cover" data-spring-image
        />
        </a>
      </figure>
      <figure class="recognition-photo recognition-photo--second">
        <a href={largePhotos[1].src} class="photo-open" data-spring-card data-photo-index="1" aria-label={`View larger: ${photos[1].alt}`}>
        <Image
          src={gustoMedals}
          alt="Two gold GUSTO College award medals held in one hand"
          width={500}
          widths={[300, 400, 500]}
          quality={70}
          sizes="(min-width: 1024px) 245px, min(43vw, 215px)"
          loading="lazy"
          class="h-full w-full object-cover" data-spring-image
        />
        </a>
      </figure>
    </div>

    <p class="recognition-caption text-sm text-(--text-faint)">GUSTO Innovation Awards & Forum, August 2026</p>
    </div>
  </div>

  <!-- Opens over the page when scripting runs; without it, each photo link opens the full-size file. -->
  <dialog class="photo-viewer" aria-labelledby="photo-viewer-caption" data-photo-viewer data-photos={JSON.stringify(largePhotos)}>
    <figure class="photo-viewer-figure">
      <div class="photo-viewer-stage" data-viewer-stage>
      <img class="photo-viewer-img" width={largePhotos[0].width} height={largePhotos[0].height} alt={largePhotos[0].alt} data-viewer-img />
      </div>
      <figcaption id="photo-viewer-caption" class="text-sm text-(--text-muted)" data-viewer-caption>{largePhotos[0].caption}</figcaption>
    </figure>

    <div class="photo-viewer-controls">
      <p class="text-sm tabular-nums text-(--text-faint)" data-viewer-count>1 of {largePhotos.length}</p>
      <div class="flex items-center gap-1">
        <button type="button" class="viewer-button" data-viewer-prev>
          <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
          Previous
        </button>
        <button type="button" class="viewer-button" data-viewer-next>
          Next
          <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
        </button>
        <button type="button" class="viewer-button" data-viewer-close>
          <Icon name="lucide:x" class="size-4" aria-hidden="true" />
          Close
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { spring } from "../../lib/animation/spring";
  type Photo = { src: string; width: number; height: number; alt: string; caption: string };

  const viewer = document.querySelector<HTMLDialogElement>("[data-photo-viewer]");

  if (viewer && typeof viewer.showModal === "function") {
    const photos: Photo[] = JSON.parse(viewer.dataset.photos ?? "[]");
    const img = viewer.querySelector<HTMLImageElement>("[data-viewer-img]");
    const caption = viewer.querySelector<HTMLElement>("[data-viewer-caption]");
    const count = viewer.querySelector<HTMLElement>("[data-viewer-count]");
    const closeButton = viewer.querySelector<HTMLButtonElement>("[data-viewer-close]");
    let current = 0;
    let opener: HTMLElement | null = null;
    let closing = false;
    let request = 0;
    let direction = 1;
    const stage = viewer.querySelector<HTMLElement>('[data-viewer-stage]');
    const outgoing = document.createElement('img');
    outgoing.className = 'photo-viewer-img photo-viewer-outgoing';
    outgoing.alt = '';
    outgoing.setAttribute('aria-hidden', 'true');
    outgoing.hidden = true;
    stage?.append(outgoing);
    const photoMotion = spring(1, value => {
      const progress = Math.max(0, Math.min(1, value));
      if (img) {
        img.style.opacity = String(progress);
        img.style.transform = `translateX(${direction * (1 - value) * 16}px)`;
      }
      outgoing.style.opacity = String(1 - progress);
      outgoing.style.transform = `translateX(${-direction * value * 12}px)`;
      if (value === 1) outgoing.hidden = true;
    }, { stiffness: 260, damping: 28 });
    const motion = spring(1, value => {
      const progress = Math.max(0, Math.min(1, value));
      viewer.style.opacity = String(progress);
      viewer.style.setProperty('--viewer-backdrop', String(progress));
      viewer.style.transform = `translateY(${(1 - value) * 20}px) scale(${0.97 + value * 0.03})`;
      if (closing && value === 0) { closing = false; viewer.close(); }
    }, { stiffness: 240, damping: 26 });
    const close = () => {
      if (!viewer.open || closing) return;
      closing = true;
      request++;
      viewer.removeAttribute('aria-busy');
      motion.set(0);
    };

    const show = async (index: number, opening = false) => {
      if (closing) return;
      const revision = ++request;
      direction = index >= current ? 1 : -1;
      current = (index + photos.length) % photos.length;
      const photo = photos[current];
      const thumbnail = document.querySelector<HTMLImageElement>(`.photo-open[data-photo-index="${current}"] img`);
      if (opening && img) {
        // Reuse the decoded thumbnail immediately; the full-size image loads without moving the layout.
        photoMotion.jump(1);
        img.src = thumbnail?.currentSrc || photo.src;
        img.alt = photo.alt;
        if (caption) caption.textContent = photo.caption;
        if (count) count.textContent = `${current + 1} of ${photos.length}`;
      }
      viewer.setAttribute('aria-busy', 'true');
      const loaded = new Image();
      loaded.src = photo.src;
      try { await loaded.decode(); }
      catch {
        if (revision === request) viewer.removeAttribute('aria-busy');
        return; // Keep the visible image if loading fails.
      }
      if (revision !== request || !viewer.open || closing || !img) return;
      photoMotion.jump(1);
      outgoing.src = img.src;
      img.src = loaded.src;
      img.alt = photo.alt;
      if (caption) caption.textContent = photo.caption;
      if (count) count.textContent = `${current + 1} of ${photos.length}`;
      viewer.removeAttribute('aria-busy');
      if (!opening) {
        outgoing.hidden = false;
        photoMotion.jump(0);
        photoMotion.set(1);
      }
    };

    for (const link of document.querySelectorAll<HTMLAnchorElement>(".photo-open")) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        opener = link;
        closing = false;
        void show(Number(link.dataset.photoIndex ?? 0), true);
        motion.jump(0);
        viewer.showModal();
        motion.set(1);
        closeButton?.focus({ preventScroll: true });
      });
    }

    viewer.querySelector("[data-viewer-prev]")?.addEventListener("click", () => show(current - 1));
    viewer.querySelector("[data-viewer-next]")?.addEventListener("click", () => show(current + 1));
    closeButton?.addEventListener("click", close);
    viewer.addEventListener("cancel", event => { event.preventDefault(); close(); });

    viewer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); void show(current - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); void show(current + 1); }
    });

    viewer.addEventListener("close", () => {
      request++;
      closing = false;
      photoMotion.jump(1);
      opener?.focus({ preventScroll: true });
    });

    // A click on the backdrop lands on the dialog itself, never on its content.
    viewer.addEventListener("click", (event) => {
      if (event.target !== viewer) return;
      const box = viewer.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) close();
    });
  }
</script>

<style>
  .recognition-gallery { align-self: start; }
  .recognition-caption { margin-top: 1rem; line-height: 1.6; max-width: 28rem; }
  .recognition-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.75rem;
  }

  .recognition-ledger {
    margin-bottom: 2.25rem;
  }

  .recognition-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  /* Result and date share the first line, with the event under them. */
  .recognition-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 1rem;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-block: 1.5rem;
  }

  .recognition-result { display: inline-flex; align-items: center; gap: .5rem; font-size: .75rem; font-weight: 500; color: var(--text-muted); }
  .recognition-result[data-winner] { color: var(--focus); }
  .recognition-event { font-size: clamp(1.125rem, 1.5vw, 1.5rem); line-height: 1.4; letter-spacing: -.025em; font-weight: 500; color: var(--text-heading);
    grid-row: 2;
    grid-column: 1 / -1;
  }

  .recognition-date {
    grid-row: 1;
    grid-column: 2;
    text-align: right;
  }

  /* 4:3 columns over 3:4 and 9:16 photos give both the same height with nothing cropped. */
  .recognition-photos {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr);
    gap: 0.75rem;
    max-width: 32rem;
  }

  .recognition-photo {
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--surface);
    outline: 1px solid var(--border);
    outline-offset: -1px;
  }

  .recognition-photo :global(img) {
    border-radius: inherit;
  }

  .photo-open {
    display: block;
    height: 100%;
    border-radius: inherit;
    cursor: zoom-in;
  }

  .photo-open :global(img) {
    transition: opacity 200ms ease;
  }

  .photo-open:hover :global(img) {
    opacity: 0.86;
  }

  /* The figure clips its overflow, so the ring sits inside the photo. */
  .photo-open:focus-visible {
    outline-offset: -4px;
  }

  .photo-viewer {
    width: min(100% - 2rem, 56rem);
    max-width: none;
    max-height: calc(100% - 2rem);
    margin: auto;
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    padding: 1rem;
    background: var(--surface);
    color: var(--text);
  }



  .photo-viewer::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    opacity: var(--viewer-backdrop, 0);
  }

  .photo-viewer-figure {
    display: grid;
    gap: 0.75rem;
  }

  .photo-viewer-stage {
    position: relative;
    height: min(62svh, 42rem);
    overflow: hidden;
    border-radius: .5rem;
    background: var(--bg);
  }

  .photo-viewer-stage :global(.photo-viewer-img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    background: var(--bg);
    object-fit: contain;
  }

  .photo-viewer-stage :global(.photo-viewer-outgoing) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .photo-viewer-stage :global(.photo-viewer-outgoing[hidden]) { display: none; }
  .photo-viewer-figure figcaption { min-height: 3.2em; }
  :global(html:has(.photo-viewer[open])) { overflow: hidden; scrollbar-gutter: stable; }

  .photo-viewer-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }

  .viewer-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    padding-inline: 0.875rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .viewer-button:hover {
    background: var(--surface-raised);
    color: var(--text-heading);
  }

  .viewer-button:active {
    background: var(--bg);
  }

  .recognition-photo--lead {
    aspect-ratio: 3 / 4;
  }

  .recognition-photo--second {
    aspect-ratio: 9 / 16;
  }

  @media (min-width: 1024px) {
    .recognition-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }

    .recognition-ledger {
      margin-bottom: 0;
    }

    .recognition-photos {
      max-width: none;
      align-self: start;
      margin-top: 1.5rem;
    }

    .recognition-caption {
      grid-column: 2;
      align-self: start;
    }
  }

  @media (min-width: 1280px) {
    .recognition-split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
    }
  }
</style>
