---
import { Icon } from "astro-icon/components";
import PostCard from "../PostCard.astro";

type Post = Awaited<
  ReturnType<typeof import("../../lib/content").getSortedPosts>
>[number];

interface Props {
  posts: Post[];
}

const { posts } = Astro.props as Props;
---

<section id="writing" class="scroll-mt-28 py-12 sm:py-16">
  <div class="mb-6 grid gap-5 border-b border-(--border) pb-6 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <h2 class="font-sans text-[clamp(2rem,3vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-(--text-heading)">
        Notes & writing
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-(--text-muted)">
        Ideas about software, systems, algorithms, and the process of learning in public, in English and Burmese.
      </p>
    </div>
    <a
      href="/writing"
      class="group inline-flex min-h-11 w-fit items-center gap-2 text-sm font-semibold text-(--text-muted) transition-colors hover:text-(--text-heading)"
    >
      View all notes
      <Icon
        name="lucide:arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-1"
        aria-hidden="true"
      />
    </a>
  </div>

  <div class="flex flex-col">
    {
      posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} headingLevel="h3" />)
      ) : (
        <p class="border-b border-(--border) px-1 py-12 text-base leading-relaxed text-(--text-muted)">
          No notes are published yet. Check back soon.
        </p>
      )
    }
  </div>
</section>
