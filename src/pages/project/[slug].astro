---
import { Image, getImage } from "astro:assets";
import CaseStudy from "../../components/project/CaseStudy.astro";
import ProjectSpec from "../../components/project/ProjectSpec.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedProjects, type ProjectEntry } from "../../lib/content";
import { buildChapters, enhanceDiagram, parseDiagram } from "../../lib/diagramNodes";
import { projectTint } from "../../lib/projectTint";
import { absoluteUrl, createAuthorSchema, createBreadcrumbSchema, siteConfig } from "../../lib/seo";

interface Props {
  project: ProjectEntry;
  nextProject?: ProjectEntry;
}

export async function getStaticPaths() {
  const projects = await getSortedProjects();

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : undefined,
    },
  }));
}

const { project, nextProject } = Astro.props as Props;
const Content = project.Content;
const caseStudy = project.data.caseStudy;

// Diagrams are pre-rendered to SVG by `npm run diagrams` (scripts/render-diagrams.mjs).
const diagramSvgs = import.meta.glob<string>("../../generated/diagrams/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
function diagramSvg(theme: "light" | "dark") {
  const path = `../../generated/diagrams/${project.id}.${theme}.svg`;
  if (!diagramSvgs[path]) throw new Error(`Missing ${path}. Run "npm run diagrams" and commit the output.`);
  return diagramSvgs[path];
}

// The system map, drawn once: every node is marked for the legend's light, and each node a component explains links to
// that component's legend item.
const diagramLabels = parseDiagram(caseStudy.diagram);
const { targets: nodeTargets } = buildChapters(caseStudy.components, caseStudy.features, diagramLabels);
function systemMap(theme: "light" | "dark") {
  return enhanceDiagram(diagramSvg(theme), { idBase: `diagram-${project.id}-${theme}`, targets: nodeTargets });
}

const maturityLabels = {
  built: "Built",
  prototype: "Prototype",
  "work-in-progress": "Work in progress",
} as const;
const projectType = project.data.type || "Product";
const maturity = maturityLabels[project.data.maturity];
const facts: { label: string; value: string; datetime?: string; id?: string }[] = [
  { label: "My role", value: project.data.role },
  { label: "Type", value: projectType.charAt(0).toUpperCase() + projectType.slice(1) },
  {
    label: "Year",
    value: String(project.data.publishedDate.getFullYear()),
    datetime: project.data.publishedDate.toISOString(),
  },
  ...(caseStudy.status && caseStudy.status !== maturity ? [{ label: "Context", value: caseStudy.status }] : []),
  { label: "Stage", value: maturity },
  // The stack sits with the other facts, one line beside its name; the row keeps the old Stack chapter's address.
  {
    label: "Stack",
    value: project.data.technologies?.length
      ? project.data.technologies.join(", ")
      : "Technology details are available in the source repository.",
    id: "stack",
  },
];
// A colour too dark or too light to tint a surface (#000 on two projects) leaves the page on its neutral surface.
const tint = projectTint(project.data.color);
const nextTint = nextProject ? projectTint(nextProject.data.color) : null;
const canonicalPath = `/project/${project.id}`;
const metaTitle = project.data.seoTitle ?? `${project.data.name} Case Study | ${siteConfig.siteName}`;
const metaDescription = project.data.seoDescription ?? project.data.description;
const socialImage = await getImage({
  src: project.data.img,
  width: 1200,
  format: "webp",
});
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: project.data.name,
    description: metaDescription,
    url: absoluteUrl(canonicalPath, Astro.site),
    image: absoluteUrl(socialImage.src, Astro.site),
    mainEntityOfPage: absoluteUrl(canonicalPath, Astro.site),
    codeRepository: project.data.source,
    dateCreated: project.data.publishedDate.toISOString(),
    programmingLanguage: project.data.technologies,
    author: createAuthorSchema(Astro.site),
  },
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "Work", path: "/projects" },
      { name: project.data.name, path: canonicalPath },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath={canonicalPath}
  image={socialImage.src}
  imageAlt={`${project.data.name} product interface`}
  keywords={[...(project.data.technologies || []), project.data.type || "software project", "software case study"]}
  structuredData={structuredData}
>
  <main id="main-content" class="project-page text-(--text)" style={tint ? `--project: ${tint}` : undefined}>
    <!-- Spec sheet + canvas: the name, actions and facts on the left (sticky while they fit), the story and the real artifacts on the right. -->
    <div class="split mx-auto w-full max-w-7xl px-5 pt-(--page-top) sm:px-6 md:px-8">
      <ProjectSpec
        slug={project.id}
        name={project.data.name}
        description={project.data.description}
        featured={project.data.featured}
        source={project.data.source}
        demo={project.data.demo}
        facts={facts}
      />

      <div class="canvas">
        <CaseStudy
          name={project.data.name}
          source={project.data.source}
          challenge={caseStudy.challenge}
          approach={caseStudy.approach}
          proofPoints={project.data.proofPoints}
          decisions={caseStudy.decisions}
          diagramLight={systemMap("light")}
          diagramDark={systemMap("dark")}
          components={caseStudy.components}
          features={caseStudy.features}
          labels={diagramLabels}
        >
          <figure slot="product" class="product-shot">
            <Image
              src={project.data.img}
              alt={`${project.data.name} product interface`}
              widths={[480, 768, 1024, 1504]}
              sizes="(max-width: 60rem) 100vw, 752px"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-video h-auto w-full object-contain"
            />
          </figure>
          {project.body && (
            <div class="prose mt-16 max-w-[40rem] prose-p:leading-7 prose-p:text-(--text-muted) prose-headings:font-semibold prose-headings:tracking-[-0.02em] prose-headings:text-(--text-heading) prose-strong:text-(--text-heading) prose-ul:text-(--text-muted) prose-ol:text-(--text-muted) prose-code:rounded-md prose-code:bg-(--border) prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.9em] prose-code:text-(--text-heading)">
              <Content />
            </div>
          )}
        </CaseStudy>
      </div>
    </div>

    {nextProject && (
      <a href={`/project/${nextProject.id}`} class="next-band" style={`--project: ${nextTint ?? "initial"}`}>
        <div class="next-inner mx-auto w-full max-w-7xl px-5 sm:px-6 md:px-8">
          <div class="next-text">
            <h2 class="next-name">{nextProject.data.name}</h2>
            <p class="mt-4 text-(--text-muted)">Next case study</p>
          </div>
          <div class="next-shot">
            <Image
              src={nextProject.data.img}
              alt=""
              widths={[400, 720, 1024]}
              sizes="(max-width: 60rem) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
      </a>
    )}
  </main>
</BaseLayout>

<style>
  /* One tint per page: the colour from the content, mixed into the page colour so both themes keep their ground.
     With no --project set (a near-black or near-white colour) the var() fails and the neutral wash is used.
     The next band sets its own --project ("initial" when its colour cannot tint) and so recomputes the wash itself. */
  .project-page,
  .next-band {
    /* The screenshot's ground: a trace of the project's colour, never a field of it. */
    --project-trace: color-mix(in oklab, var(--project) 6%, var(--bg));
    --project-wash: color-mix(in oklab, var(--project) 14%, var(--bg));
    --project-wash-strong: color-mix(in oklab, var(--project) 24%, var(--bg));
    /* The neutral wash for colours that cannot tint: a step of ink into the page, visible in both themes. */
    --neutral-trace: color-mix(in oklab, var(--text-heading) 3%, var(--bg));
    --neutral-wash: color-mix(in oklab, var(--text-heading) 5%, var(--bg));
    --neutral-wash-strong: color-mix(in oklab, var(--text-heading) 9%, var(--bg));
  }

  /* Under 60rem: one column in reading order (name, sentence, actions, properties, then the canvas: screenshot, story,
     map, features, provenance). */
  .canvas {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap-s);
    margin-top: 2.5rem;
    min-width: 0;
  }

  .product-shot {
    min-width: 0;
    margin: 0 0 calc(2.5rem - var(--section-gap-s));
    overflow: hidden;
    border-radius: 0.75rem;
    outline: 1px solid var(--border);
    outline-offset: -1px;
    background: var(--project-trace, var(--neutral-trace));
  }

  /* 60rem wide and tall enough for the sheet: twelve columns, the sheet on 1 to 4 and the canvas on 6 to 12, both from
     the top of the page. When the sheet cannot fit under the bar (data-loose, set by its script) the page keeps the one
     column, so the left never stands empty beside a static sheet. */
  @media (min-width: 60rem) and (min-height: 40rem) {
    .split:not(:has(> [data-spec][data-loose])) {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      align-items: start;
    }

    .split:not(:has(> [data-spec][data-loose])) .canvas {
      /* The canvas's parts follow each other closer than page sections: they are one sheet of artifacts. */
      gap: 3rem;
      grid-column: 6 / span 7;
      margin-top: 0;
    }

    .split:not(:has(> [data-spec][data-loose])) .product-shot {
      margin-bottom: 0;
    }
  }

  /* The next case study: a band in that project's own tint, its screen cropped wide beside its name. */
  .next-band {
    display: block;
    margin-top: var(--section-gap-s);
    background: var(--project-wash, var(--neutral-wash));
    color: var(--text-heading);
    text-decoration: none;
    transition: background-color 200ms ease-out;
  }

  .next-band:hover,
  .next-band:active {
    background: var(--project-wash-strong, var(--neutral-wash-strong));
  }

  .next-band:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -6px;
    transition: none;
  }

  .next-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: 3.5rem;
  }

  .next-name {
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-heading);
  }

  .next-shot {
    aspect-ratio: 21 / 9;
    min-width: 0;
    overflow: hidden;
    border-radius: 0.75rem;
    outline: 1px solid var(--border);
    outline-offset: -1px;
    background: var(--surface);
  }

  @media (min-width: 60rem) {
    .next-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 4rem;
      padding-block: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next-band {
      transition: none;
    }
  }
</style>
