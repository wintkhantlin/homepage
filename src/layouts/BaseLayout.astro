---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReturnMark from "../components/ReturnMark.astro";
import Cursor from "../components/Cursor.astro";
import "./../styles/global.css";
import { Font } from "astro:assets";
import { absoluteUrl, dedupeKeywords, siteConfig } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  canonicalPath?: string;
  keywords?: string[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  lang?: string;
  locale?: string;
  compactFooter?: boolean;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  image = siteConfig.defaultImage,
  imageAlt = siteConfig.siteName,
  type = "website",
  canonicalPath,
  keywords = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  structuredData,
  lang = "en",
  locale = siteConfig.locale,
  compactFooter = false,
} = Astro.props as Props;

const pathname = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = Astro.site ? absoluteUrl(pathname, Astro.site) : undefined;
const imageUrl = image ? absoluteUrl(image, Astro.site) : undefined;
const twitterCard = "summary_large_image";
const metaKeywords = dedupeKeywords([...siteConfig.defaultKeywords, ...keywords]);
const structuredDataPayload = structuredData
  ? JSON.stringify(Array.isArray(structuredData) ? structuredData : [structuredData]).replace(/</gu, "\\u003c")
  : undefined;
---

<html lang={lang} data-physics-home={pathname === "/" ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" />
    <link rel="preconnect" href="https://github.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://www.linkedin.com" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.siteName} RSS feed`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content={metaKeywords.join(", ")} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0d0c" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Only the pinned scheme, applied before first paint; Header.astro does the switching.
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = theme;
          document.documentElement.dataset.theme = 'github-' + theme + '-high-contrast';
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = theme === 'light' ? '#fafafa' : '#0c0d0c';
        }
      } catch {}
    </script>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {type === "profile" && <meta property="profile:first_name" content={siteConfig.givenName} />}
    {type === "profile" && <meta property="profile:last_name" content={siteConfig.familyName} />}
    {type === "profile" && <meta property="profile:username" content={siteConfig.handle} />}
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={imageAlt} />}

    {
      structuredDataPayload && (
        <script is:inline type="application/ld+json" set:html={structuredDataPayload} />
      )
    }
  </head>
  <body>
    <a lang="en" class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <slot />
    <Footer compact={compactFooter} />
    <ReturnMark />
    <Cursor />
    <script>
      import "../lib/animation/physicsText";
    </script>
  </body>
</html>
