---
import { Icon } from "astro-icon/components";

interface Props {
  challenge: string;
  approach: string;
  architecture: string[];
  highlights: string[];
  diagram: string;
}

const { challenge, approach, architecture, highlights, diagram } = Astro.props as Props;
---

<div class="space-y-20">
  <section id="the-challenge">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      The challenge
    </h2>
    <p class="mt-6 max-w-[68ch] text-base leading-8 text-(--text-muted) sm:text-lg">
      {challenge}
    </p>
  </section>

  <section id="the-approach">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      The approach
    </h2>
    <p class="mt-6 max-w-[68ch] text-base leading-8 text-(--text-muted) sm:text-lg">
      {approach}
    </p>
  </section>

  <section id="system-architecture">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      System architecture
    </h2>
    <div
      class="mermaid-enhancement mt-7 overscroll-x-contain overflow-x-auto rounded-2xl border border-(--border) bg-(--surface) p-4 sm:p-8"
      data-mermaid-diagram
      tabindex="0"
      aria-label="Scrollable system architecture diagram"
    >
      <pre class="hidden" data-mermaid-source>{diagram}</pre>
      <div
        class="flex min-h-72 min-w-176 items-center justify-center text-sm text-(--text-faint)"
        data-mermaid-output
        role="img"
        aria-label="System architecture diagram"
        aria-live="polite"
        aria-busy="true"
      >
        Rendering architecture…
      </div>
      <div class="hidden min-h-72 flex-col items-center justify-center gap-4 text-center" data-mermaid-error role="alert">
        <p class="max-w-md text-sm leading-6 text-(--text-muted)">
          The architecture diagram could not be rendered. The same system details remain available in the list below.
        </p>
        <button
          type="button"
          class="min-h-11 rounded-full border border-(--border) px-5 text-sm font-semibold text-(--text-heading) transition-colors hover:bg-(--border)"
          data-mermaid-retry
        >
          Try rendering again
        </button>
      </div>
    </div>

    <button
      type="button"
      class="-ml-3 mt-3 hidden min-h-11 cursor-pointer items-center gap-2 rounded-full px-3 text-sm font-medium text-(--text-muted) transition-[background-color,color] duration-200 hover:bg-(--surface-raised) hover:text-(--text-heading) active:bg-(--surface)"
      data-diagram-enlarge
    >
      <Icon name="lucide:maximize-2" class="size-4" aria-hidden="true" />
      Enlarge diagram
    </button>

    <dialog class="diagram-viewer" aria-label="System architecture diagram, enlarged" data-diagram-viewer>
      <div class="diagram-viewer-canvas" tabindex="0" aria-label="Scrollable system architecture diagram" data-diagram-canvas></div>
      <div class="mt-3 flex justify-end">
        <button type="button" class="viewer-button" data-diagram-close>
          <Icon name="lucide:x" class="size-4" aria-hidden="true" />
          Close
        </button>
      </div>
    </dialog>
  </section>

  <section id="how-it-is-structured">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      How it is structured
    </h2>
    <ol class="mt-7 border-t border-(--border)">
      {architecture.map((item, index) => (
        <li class="grid gap-4 border-b border-(--border) py-5 sm:grid-cols-[2rem_1fr]">
          <span class="font-mono text-xs text-(--text-faint)">{String(index + 1).padStart(2, "0")}</span>
          <span class="text-base leading-relaxed text-(--text-muted)">{item}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="what-it-includes">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      What it includes
    </h2>
    <ul class="mt-7 grid gap-px overflow-hidden rounded-xl border border-(--border) bg-(--border) sm:grid-cols-2">
      {highlights.map((item) => (
        <li class="bg-(--surface) p-6 text-base leading-relaxed text-(--text-muted)">{item}</li>
      ))}
    </ul>
  </section>
</div>

<script>
  type Mermaid = typeof import("mermaid").default;
  let mermaidPromise: Promise<Mermaid> | undefined;
  const enlarge = document.querySelector<HTMLButtonElement>("[data-diagram-enlarge]");

  function loadMermaid() {
    mermaidPromise ??= import("mermaid").then((module) => module.default);
    return mermaidPromise;
  }

  function configureMermaid(mermaid: Mermaid) {
    const styles = getComputedStyle(document.documentElement);
    const background = styles.getPropertyValue("--bg").trim();
    const heading = styles.getPropertyValue("--text-heading").trim();
    const muted = styles.getPropertyValue("--text-muted").trim();

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      fontFamily: styles.fontFamily,
      themeVariables: {
        background,
        primaryColor: heading,
        primaryTextColor: background,
        primaryBorderColor: muted,
        secondaryColor: background,
        secondaryTextColor: heading,
        secondaryBorderColor: muted,
        lineColor: muted,
        textColor: heading,
      },
      flowchart: {
        curve: "basis",
        htmlLabels: false,
        useMaxWidth: true,
      },
    });
  }

  async function renderDiagram(force = false) {
    const diagram = document.querySelector<HTMLElement>("[data-mermaid-diagram]");
    const source = diagram?.querySelector<HTMLElement>("[data-mermaid-source]")?.textContent?.trim();
    const output = diagram?.querySelector<HTMLElement>("[data-mermaid-output]");
    const errorState = diagram?.querySelector<HTMLElement>("[data-mermaid-error]");

    if (!diagram || !source || !output || !errorState) return;
    if (diagram.dataset.loading === "true") return;
    if (!force && diagram.dataset.rendered === "true") return;

    diagram.dataset.loading = "true";
    diagram.dataset.rendered = "false";
    enlarge?.classList.add("hidden");
    enlarge?.classList.remove("inline-flex");
    errorState.classList.add("hidden");
    errorState.classList.remove("flex");
    output.classList.remove("hidden");
    output.classList.add("flex", "min-h-72");
    output.setAttribute("aria-busy", "true");
    output.textContent = "Rendering architecture…";

    try {
      const mermaid = await loadMermaid();
      configureMermaid(mermaid);
      const { svg, bindFunctions } = await mermaid.render(`case-diagram-${Date.now()}`, source);
      output.innerHTML = svg;
      output.classList.remove("min-h-72");
      output.setAttribute("aria-busy", "false");
      bindFunctions?.(output);
      diagram.dataset.rendered = "true";
      enlarge?.classList.remove("hidden");
      enlarge?.classList.add("inline-flex");
    } catch (error) {
      output.classList.add("hidden");
      output.classList.remove("flex");
      output.setAttribute("aria-busy", "false");
      errorState.classList.remove("hidden");
      errorState.classList.add("flex");
      console.error("Unable to render Mermaid diagram", error);
    } finally {
      diagram.dataset.loading = "false";
    }
  }

  const diagram = document.querySelector<HTMLElement>("[data-mermaid-diagram]");
  const retry = diagram?.querySelector<HTMLButtonElement>("[data-mermaid-retry]");

  const viewer = document.querySelector<HTMLDialogElement>("[data-diagram-viewer]");
  const canvas = viewer?.querySelector<HTMLElement>("[data-diagram-canvas]");
  const closeViewer = viewer?.querySelector<HTMLButtonElement>("[data-diagram-close]");

  // The viewer shows a copy of the rendered diagram, so it always matches the current theme.
  enlarge?.addEventListener("click", () => {
    const svg = diagram?.querySelector<SVGSVGElement>("[data-mermaid-output] svg");
    if (!viewer || !canvas || !svg) return;
    const copy = svg.cloneNode(true) as SVGSVGElement;
    copy.style.maxWidth = "none";
    canvas.replaceChildren(copy);
    viewer.showModal();
    closeViewer?.focus();
  });

  closeViewer?.addEventListener("click", () => viewer?.close());

  // A click on the backdrop lands on the dialog itself, never on its content.
  viewer?.addEventListener("click", (event) => {
    if (event.target === viewer) viewer.close();
  });

  retry?.addEventListener("click", () => void renderDiagram(true));
  window.addEventListener("portfolio:theme-change", () => {
    if (diagram?.dataset.rendered === "true") void renderDiagram(true);
  });

  if (diagram && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void renderDiagram();
      },
      { rootMargin: "320px" },
    );
    observer.observe(diagram);
  } else {
    void renderDiagram();
  }
</script>

<style>
  .diagram-viewer {
    width: min(100% - 2rem, 88rem);
    max-width: none;
    max-height: calc(100% - 2rem);
    margin: auto;
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    padding: 1rem;
    background: var(--surface);
    color: var(--text);
  }

  .diagram-viewer::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  .diagram-viewer-canvas {
    overflow: auto;
    overscroll-behavior: contain;
    border-radius: 0.5rem;
  }

  /* Phones keep the diagram legible and scroll it sideways; larger screens fit the whole of it in view. */
  .diagram-viewer-canvas :global(svg) {
    display: block;
    width: 100%;
    min-width: 64rem;
    height: auto;
  }

  @media (min-width: 768px) {
    .diagram-viewer-canvas :global(svg) {
      min-width: 0;
      max-height: calc(100svh - 9rem);
    }
  }

  .viewer-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    padding-inline: 0.875rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .viewer-button:hover {
    background: var(--surface-raised);
    color: var(--text-heading);
  }

  .viewer-button:active {
    background: var(--bg);
  }
</style>
