---
interface Props {
  href?: string;
  [key: string]: unknown;
}

const { href = "", ...attributes } = Astro.props as Props;
const isExternal = /^https?:\/\//u.test(href);
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  {...attributes}
>
  <slot />
</a>
