---
import { getSortedPosts, type PostEntry } from "../../lib/content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl, createBreadcrumbSchema, siteConfig } from "../../lib/seo";
import profilePhoto from "../../assets/img/happer.png";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: PostEntry };
const Content = post.Content;
const description = post.data.description ?? post.data.summary ?? siteConfig.defaultDescription;
const metaDescription = post.data.seoDescription ?? description;
const publishedTime = post.data.publishedDate.toISOString();
const isMyanmar = /[\u1000-\u109F]/u.test(post.data.title);
const language = post.data.lang ?? (isMyanmar ? "my" : "en");
const canonicalPath = `/post/${post.id}`;
const canonicalUrl = absoluteUrl(canonicalPath, Astro.site);

const socialImage = await getImage({
  src: profilePhoto,
  width: 1200,
  height: 630,
  format: "webp",
});

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: metaDescription,
    image: absoluteUrl(socialImage.src, Astro.site),
    datePublished: publishedTime,
    dateModified: publishedTime,
    inLanguage: language,
    author: {
      "@type": "Person",
      "@id": absoluteUrl("/#person", Astro.site),
      name: siteConfig.author,
      url: absoluteUrl("/", Astro.site),
    },
    publisher: {
      "@type": "Person",
      "@id": absoluteUrl("/#person", Astro.site),
      name: siteConfig.author,
      url: absoluteUrl("/", Astro.site),
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    keywords: post.data.categories,
  },
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "Writing", path: "/writing" },
      { name: post.data.title, path: canonicalPath },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={post.data.seoTitle ?? `${post.data.title} | ${siteConfig.siteName}`}
  description={metaDescription}
  canonicalPath={canonicalPath}
  image={socialImage.src}
  imageAlt={`${post.data.title} - ${siteConfig.author}`}
  keywords={[
    ...post.data.categories,
    "programming article",
    "software engineering blog",
  ]}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={publishedTime}
  structuredData={structuredData}
  lang={language}
  locale={language === "my" ? "my_MM" : siteConfig.locale}
>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-5 pb-24 pt-36 sm:px-6 md:px-8 sm:pt-40">
    <!-- Back -->
    <div class="mb-14">
      <a
        href="/writing"
        class="inline-flex min-h-11 items-center gap-2 text-sm text-(--text-muted) transition-colors hover:text-(--text-heading) active:text-(--text-heading)"
      >
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        <span>All notes</span>
      </a>
    </div>

    <!-- Header -->
    <section class="mb-16 border-b border-(--border) pb-12">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="text-[10px] font-medium uppercase tracking-widest text-(--text-muted)">
          {post.data.categories.join(" / ")}
        </span>

        <span class="text-xs text-(--text-faint)" aria-hidden="true">·</span>

        <time datetime={publishedTime} class="font-mono text-[11px] tabular-nums text-(--text-muted)">
          {
            post.data.publishedDate.toLocaleDateString("en-US", {
              month: "long",
              day: "numeric",
              year: "numeric",
            })
          }
        </time>

        <span class="text-xs text-(--text-faint)" aria-hidden="true">·</span>
        <span class="text-[11px] text-(--text-muted)">By {siteConfig.author}</span>
      </div>

      <h1
        class:list={[
          "max-w-4xl font-serif text-[clamp(2.75rem,7vw,6rem)] font-normal tracking-[-0.035em] text-(--text-heading)",
          isMyanmar ? "leading-[1.08]" : "leading-[0.98]",
        ]}
      >
        {post.data.title}
      </h1>

      {
        (post.data.description ?? post.data.summary) && (
          <p class="mt-4 max-w-2xl text-[15px] leading-7 text-(--text-muted)">
            {post.data.description ?? post.data.summary}
          </p>
        )
      }
    </section>

    <!-- Body -->
    <article
      class="prose mb-24 max-w-[68ch]
      prose-p:mb-6 prose-p:leading-7 prose-p:text-(--text-muted)

      prose-headings:font-medium
      prose-headings:tracking-[-0.02em]
      prose-h2:mb-3 prose-h2:mt-10 prose-h2:text-(--text-heading)
      prose-h3:mb-2 prose-h3:mt-8 prose-h3:text-(--text-heading)

      prose-strong:text-(--text-heading)

      prose-a:text-(--text-heading)
      prose-a:underline
      prose-a:decoration-(--border)
      prose-a:underline-offset-[3px]
      hover:prose-a:decoration-(--text-heading)

      prose-ul:text-(--text-muted)
      prose-ol:text-(--text-muted)
      prose-li:my-1

      prose-blockquote:border-l-2
      prose-blockquote:border-(--border)
      prose-blockquote:pl-4
      prose-blockquote:italic
      prose-blockquote:text-(--text-muted)

      prose-img:rounded-xl
      prose-img:border
      prose-img:border-(--border)

      prose-th:text-(--text-heading)
      prose-td:text-(--text-muted)

      prose-code:rounded-md
      prose-code:px-1.5
      prose-code:py-0.5
      prose-code:text-[0.9em]
      prose-code:font-medium
      prose-code:text-(--text-heading)

      prose-code:before:content-none
      prose-code:after:content-none

      prose-pre:overflow-x-auto
      prose-pre:rounded-2xl
      prose-pre:border
      prose-pre:border-white/5
      prose-pre:bg-[#1e252f]
      prose-pre:px-6
      prose-pre:py-5
      prose-pre:shadow-[inset_0_1px_0_rgba(255,255,255,0.03)]

      prose-pre:code:bg-transparent
      prose-pre:code:p-0
      prose-pre:code:text-[15px]
      prose-pre:code:leading-8
      prose-pre:code:font-normal
      prose-pre:code:text-[#e5e7eb]"
    >
      <Content />
    </article>
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const links = document.querySelectorAll(".prose a");

      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (!href) return;

        const isInternal =
          href.startsWith("/") ||
          href.startsWith("#") ||
          href.startsWith("./");

        if (isInternal) return;

        try {
          const url = new URL(href, window.location.origin);

          if (url.origin !== window.location.origin) {
            link.setAttribute("target", "_blank");
            link.setAttribute("rel", "noopener noreferrer");
          }
        } catch {}
      });
    });
  </script>
</BaseLayout>
