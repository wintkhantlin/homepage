---
import { Icon } from "astro-icon/components";

const links = [
  { label: "Work", href: "/projects", section: "projects" },
  { label: "Notes", href: "/writing", section: "writing" },
  { label: "About", href: "/#about", section: "about" },
];

const pathname = Astro.url.pathname;
// On the homepage the nav scrolls to its sections, so the scroll-spy highlight and the click agree.
const isHome = pathname === "/";
const isActive = (href: string) => {
  if (href === "/writing") return pathname === "/writing" || pathname.startsWith("/post/");
  if (href === "/projects") return pathname === "/projects" || pathname.startsWith("/project/");
  return false;
};
---

<!-- The bar sits on the page rather than over it: the wordmark heads the name's column and the links start where the hero's line does. -->
<header class="site-header absolute inset-x-0 top-0 z-50">
  <div class="site-header-inner mx-auto w-full max-w-7xl px-5 sm:px-6 md:px-8">
    <a
      href="/"
      class="inline-flex min-h-11 min-w-11 items-center text-sm font-semibold tracking-[-0.01em] text-(--text-heading) transition-opacity duration-200 hover:opacity-60 active:opacity-45 sm:text-base"
    >
      <span class="sm:hidden">WK</span>
      <span class="hidden sm:inline">Wint Khant Lin</span>
    </a>

    <nav class="site-nav flex items-center gap-0 sm:gap-5" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={isHome ? `#${link.section}` : link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            data-nav-section={link.section}
            class:list={[
              "inline-flex min-h-11 items-center whitespace-nowrap px-1.5 text-[13px] text-(--text-muted) underline decoration-transparent underline-offset-8 transition-[color,text-decoration-color] duration-300 hover:text-(--text-heading) active:text-(--text-heading) data-[current]:text-(--text-heading) data-[current]:decoration-(--text-faint) sm:text-[14px]",
              { "text-(--text-heading) decoration-(--text-faint)": isActive(link.href) },
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <!--email_off-->
      <a
        href="mailto:wintkhantlin@gmail.com"
        class="inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap px-1.5 text-[13px] font-medium text-(--text-heading) lg:ml-auto underline decoration-transparent underline-offset-8 transition-[text-decoration-color] duration-300 hover:decoration-(--text-heading) sm:text-[14px]"
      >
        <Icon name="lucide:mail" class="size-3.5" aria-hidden="true" />
        <span class="sm:hidden">Email</span>
        <span class="hidden sm:inline">Say hello</span>
      </a>
      <!--/email_off-->

      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to light theme"
        aria-pressed="false"
        class="flex size-11 cursor-pointer items-center justify-center rounded-full text-(--text-muted) transition-[background-color,color,transform] duration-300 hover:bg-(--surface-raised) hover:text-(--text-heading) active:scale-95 -mr-3"
      >
        <span id="theme-icon-dark" class="hidden">
          <Icon name="lucide:sun" class="size-3.75" />
        </span>
        <span id="theme-icon-light" class="hidden">
          <Icon name="lucide:moon" class="size-3.75" />
        </span>
      </button>
    </nav>
  </div>
</header>

<style>
  /* Without scripting the bar sits in the page; with it, it stays reachable: hidden while reading down, back on the way up. */
  :global(.js) .site-header {
    position: fixed;
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .site-header[data-scrolled] {
    background: var(--bg);
    box-shadow: 0 1px 0 var(--border);
  }

  .site-header[data-hidden]:not(:focus-within) {
    transform: translateY(-100%);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  /* The same split as the home hero, so the links line up over its line and actions. */
  @media (min-width: 1024px) {
    .site-header-inner {
      display: grid;
      grid-template-columns: minmax(0, 64fr) minmax(0, 36fr);
      column-gap: 3rem;
    }
  }
</style>

<script>
  function updateIcons() {
    const isLight = document.documentElement.classList.contains("light");
    const darkIcon = document.getElementById("theme-icon-dark");
    const lightIcon = document.getElementById("theme-icon-light");
    const button = document.getElementById("theme-toggle");
    const themeColor = document.getElementById("theme-color");

    if (darkIcon) darkIcon.classList.toggle("hidden", isLight);
    if (lightIcon) lightIcon.classList.toggle("hidden", !isLight);
    button?.setAttribute("aria-label", isLight ? "Switch to dark theme" : "Switch to light theme");
    button?.setAttribute("aria-pressed", String(isLight));
    themeColor?.setAttribute("content", isLight ? "#fafafa" : "#0c0d0c");
  }

  function persistTheme(theme: "light" | "dark") {
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.classList.toggle("light", theme === "light");
    document.documentElement.dataset.theme = theme === "light"
      ? "github-light-high-contrast"
      : "github-dark-high-contrast";
    persistTheme(theme);
    updateIcons();
    window.dispatchEvent(new CustomEvent("portfolio:theme-change"));
  }

  function toggleTheme() {
    const isLight = document.documentElement.classList.contains("light");
    const newTheme = isLight ? "dark" : "light";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (document.startViewTransition && !reduceMotion) {
      document.startViewTransition(() => {
        applyTheme(newTheme);
      });
    } else {
      applyTheme(newTheme);
    }
  }

  updateIcons();

  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", toggleTheme);

  // On the homepage, mark the nav link whose section is in view.
  function trackActiveSection() {
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]")];
    const sections = navLinks
      .map((link) => document.getElementById(link.dataset.navSection ?? ""))
      .filter((section): section is HTMLElement => Boolean(section));
    if (!sections.length) return;

    const setCurrent = (id?: string) => {
      for (const link of navLinks) {
        const isCurrent = link.dataset.navSection === id;
        link.toggleAttribute("data-current", isCurrent);
        if (isCurrent) link.setAttribute("aria-current", "location");
        else if (link.getAttribute("aria-current") === "location") link.removeAttribute("aria-current");
      }
    };

    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        setCurrent(sections.find((section) => visible.has(section.id))?.id);
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }

  trackActiveSection();

  // Hide the bar while the reader scrolls down, bring it back as soon as they scroll up.
  function trackScrollDirection() {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header) return;

    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const atTop = y < 8;
      header.toggleAttribute("data-scrolled", !atTop);

      if (atTop || y < lastY - 4) header.removeAttribute("data-hidden");
      else if (y > lastY + 4 && y > header.offsetHeight * 2) header.setAttribute("data-hidden", "");

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  trackScrollDirection();
</script>
