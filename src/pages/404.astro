---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title="404 — Page Not Found | Wint Khant Lin"
  description="The requested page could not be found. Return to Wint Khant Lin's software engineering portfolio, projects, and programming notes."
  noindex={true}
>
  <main id="main-content" class="mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-5 pt-24 text-center sm:px-6 md:px-8">
    <p class="font-sans text-6xl font-semibold tracking-[-0.04em] text-(--text-faint) md:text-7xl">
      404
    </p>

    <h1 class="mt-2 text-xl font-medium text-(--text-heading)">
      This page doesn’t exist
    </h1>

    <p class="mt-3 max-w-md text-sm text-(--text-muted)">
      You might have followed an old link, or the page may have moved. Let’s get you back on track.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-2 gap-y-2">
      <a
        href="/"
        class="inline-flex min-h-11 items-center gap-2 rounded-full bg-(--text-heading) px-5 text-sm font-semibold text-(--bg) transition-transform duration-300 hover:-translate-y-0.5 active:translate-y-0"
      >
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        <span>Back to home</span>
      </a>
      <a
        href="/projects"
        class="inline-flex min-h-11 items-center px-4 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading)"
      >
        See the work
      </a>
      <a
        href="/writing"
        class="inline-flex min-h-11 items-center px-4 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading)"
      >
        Read the notes
      </a>
    </div>
  </main>
</BaseLayout>
