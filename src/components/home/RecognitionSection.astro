---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import gustoMedals from "../../assets/img/awards/gusto-innovation-golden-metals.png";
import gustoWinnerPose from "../../assets/img/awards/gusto-innovation-winner-pose.png";
import gustoProjectDisplay from "../../assets/img/awards/polo-gusto-innovation-1.jpeg";
import letsTechWinnerPose from "../../assets/img/awards/lets-tech-hackathon-winner-pose.png";

interface RecognitionImage {
  src: ImageMetadata;
  alt: string;
  renderWidth: number;
}

interface Recognition {
  result: string;
  event: string;
  datetime: string;
  date: string;
  images?: RecognitionImage[];
}

const recognitions: Recognition[] = [
  {
    result: "First runner-up",
    event: "GUSTO Innovation Awards & Forum 2026",
    datetime: "2026-08",
    date: "August 2026",
    images: [
      {
        src: gustoWinnerPose,
        alt: "Wint holding first runner-up and social media award boards at the GUSTO Innovation Awards & Forum",
        renderWidth: 420,
      },
      {
        src: gustoMedals,
        alt: "Two gold GUSTO College award medals held in one hand",
        renderWidth: 240,
      },
      {
        src: gustoProjectDisplay,
        alt: "The team's secured recommerce marketplace display at the GUSTO Innovation Awards & Forum",
        renderWidth: 320,
      },
    ],
  },
  {
    result: "Winner",
    event: "Let's Tech 2026: Agentic Edition",
    datetime: "2026-07",
    date: "July 2026",
    images: [
      {
        src: letsTechWinnerPose,
        alt: "Wint holding the Let's Tech Hackathon winner board",
        renderWidth: 320,
      },
    ],
  },
  {
    result: "Winner",
    event: "GUSTO Technical Competition 2026",
    datetime: "2026-01",
    date: "January 2026",
  },
];
---

<section id="recognition" aria-labelledby="recognition-heading" class="scroll-mt-28 py-12 sm:py-16">
  <div class="grid gap-6 border-b border-(--border) pb-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <h2
        id="recognition-heading"
        class="font-sans text-[clamp(2rem,3vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-(--text-heading)"
      >
        Competition results
      </h2>
    </div>
  </div>

  <ol>
    {
      recognitions.map((recognition, index) => (
        <li
          class:list={["recognition-row", { "recognition-row--preview": recognition.images }]}
        >
          <span class="font-mono text-xs tabular-nums text-(--text-faint)" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <p class="text-sm font-semibold text-(--text-heading)">{recognition.result}</p>
          <p class="max-w-2xl text-base leading-relaxed text-(--text-muted)">{recognition.event}</p>
          <time
            datetime={recognition.datetime}
            class="font-mono text-xs tabular-nums text-(--text-faint) md:text-right"
          >
            {recognition.date}
          </time>

          {recognition.images && (
            <aside
              class:list={["award-preview", { "award-preview--gallery": recognition.images.length > 1 }]}
              aria-label={`${recognition.event} photographs`}
            >
              {recognition.images.map((image) => (
                <figure>
                  <Image
                    src={image.src}
                    alt={image.alt}
                    width={image.renderWidth}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </figure>
              ))}
            </aside>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .recognition-row {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.4rem 1rem;
    border-bottom: 1px solid var(--border);
    padding-block: 1.75rem;
  }

  @media (max-width: 767px) {
    .recognition-row > span {
      grid-column: 1;
      grid-row: 1;
      align-self: baseline;
      margin-top: 0.15rem;
    }

    .recognition-row > p:nth-of-type(1) {
      grid-column: 2;
      grid-row: 1;
      align-self: baseline;
    }

    .recognition-row > p:nth-of-type(2) {
      grid-column: 2;
      grid-row: 2;
    }

    .recognition-row > time {
      grid-column: 2;
      grid-row: 3;
    }

    .recognition-row > .award-preview {
      grid-column: 2;
      grid-row: 4;
      margin-top: 0.5rem;
    }
  }

  @media (min-width: 768px) {
    .recognition-row {
      grid-template-columns: 2.5rem minmax(9rem, 0.7fr) minmax(0, 1.8fr) 8rem;
      align-items: baseline;
      gap: 1.5rem;
      padding-block: 2rem;
    }

    .recognition-row > .award-preview {
      grid-column: 3 / -1;
    }
  }

  /* Award photos sit inline on every screen size: they are proof, not a hover surprise. */
  .award-preview {
    display: flex;
    gap: 0.375rem;
    height: 5.5rem;
    margin-top: 0.25rem;
  }

  .award-preview figure {
    height: 100%;
    aspect-ratio: 3 / 4;
    flex: none;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--border);
  }

</style>
