---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectsSection from "../components/home/ProjectsSection.astro";
import { getSortedProjects } from "../lib/content";
import { createBreadcrumbSchema, siteConfig } from "../lib/seo";
import profilePhoto from "../assets/img/happer.png";
import { getImage } from "astro:assets";

const [projects, socialImage] = await Promise.all([
  getSortedProjects(),
  getImage({
    src: profilePhoto,
    width: 1200,
    height: 630,
    format: "webp",
  }),
]);

const title = `Software Projects & Case Studies | ${siteConfig.siteName}`;
const description =
  "Explore Wint Khant Lin's software projects, including backend systems, distributed architectures, open-source builds, and technical experiments.";
const structuredData = createBreadcrumbSchema(
  [
    { name: "Home", path: "/" },
    { name: "Projects", path: "/projects" },
  ],
  Astro.site,
);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/projects"
  image={socialImage.src}
  imageAlt="Wint Khant Lin software projects"
  keywords={["software projects", "backend case studies", "distributed systems portfolio"]}
  structuredData={structuredData}
>
  <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-7xl overflow-x-hidden px-5 pb-20 pt-20 text-(--text) sm:px-6 sm:pt-24 md:px-8">
    <ProjectsSection
      projects={projects}
      heading="Projects"
      headingLevel="h1"
      description="Open-source builds, product experiments, and hackathon work, with maturity and architectural evidence made explicit."
    />
  </main>
</BaseLayout>
