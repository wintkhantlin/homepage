---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../lib/seo";
import CopyEmailButton from "../CopyEmailButton.astro";

const email = siteConfig.social.email.replace("mailto:", "");
---

<!-- Ledge: a quiet field fills the first screen and the staggered name rests at its base, the line and actions beside its last line. -->
<section class="hero" aria-labelledby="hero-name">
  <h1 id="hero-name" class="hero-name font-sans font-semibold text-(--text-heading)">
    <span class="hero-name-line block">Wint</span>{" "}
    <span class="hero-name-line block pl-[0.9em]">Khant</span>{" "}
    <span class="hero-name-line flex flex-wrap items-baseline gap-x-5 gap-y-2 pl-[1.8em]">
      Lin{" "}
      <span class="hero-alias font-sans text-sm font-medium leading-none tracking-normal text-(--text-faint) sm:text-base">also known as Happer</span>
    </span>
  </h1>

  <div class="hero-side">
    <p class="hero-lede max-w-[26rem] text-pretty text-lead leading-relaxed text-(--text-muted)">
      <span class="text-(--text-heading)">Software engineer and college student from Myanmar</span>, building
      reliable backend systems.
    </p>

    <!--email_off-->
    <div class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-2">
      <a href={siteConfig.social.email} class="hero-cta group inline-flex min-h-12 items-center gap-3 whitespace-nowrap rounded-full px-5 text-sm font-semibold duration-200 ease-out active:translate-y-px sm:text-base">
        <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
        {email}
      </a>
      <CopyEmailButton email={email} />
    </div>
    <!--/email_off-->

    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-1">
      <a
        href="#projects"
        class="group inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading) sm:text-base"
      >
        See the work
        <Icon name="lucide:arrow-down" class="size-4 transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true" />
      </a>
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading) sm:text-base"
      >
        GitHub<span class="sr-only"> (opens in a new tab)</span>
        <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<script>
  import { advanceChain, PHYSICS_STEP, type Spring } from "../../lib/animation/namePhysics";
  // The name answers the pointer: letters close to it swell heavy and take the accent, the ones around them
  // thin out and lean away. Everything rides on springs, so it overshoots a little and settles on its own.
  const REACH_EM = 0.62;
  const WAKE_RATIO = 2.1;
  const SWELL_WEIGHT = 290;
  const THIN_WEIGHT = 110;
  // Wide and gentle, so a whole word makes room instead of one letter crashing into the next.
  const PUSH_REACH_EM = 1.4;
  const PUSH_EM = 0.16;
  const LIFT_EM = 0.055;
  // Seconds-based damped oscillator: identical response at any display refresh rate.
  const FREQUENCY = 19;
  const DAMPING_RATIO = 0.72;

  type Letter = {
    element: HTMLElement;
    line: number;
    restX: number;
    restY: number;
    x: Spring;
    y: Spring;
    rotation: Spring;
    mass: number;
    weight: Spring;
    tint: number;
  };

  // Moves a spring one step toward its goal and reports how far it still has to go.
  const pull = (spring: Spring, goal: number, step: number) => {
    const displacement = spring.value - goal;
    const decay = FREQUENCY * DAMPING_RATIO;
    const frequency = FREQUENCY * Math.sqrt(1 - DAMPING_RATIO ** 2);
    const envelope = Math.exp(-decay * step);
    const sine = Math.sin(frequency * step);
    const cosine = Math.cos(frequency * step);
    const coefficient = (spring.velocity + decay * displacement) / frequency;
    spring.value = goal + envelope * (displacement * cosine + coefficient * sine);
    spring.velocity = envelope * (
      spring.velocity * cosine - (decay * coefficient + frequency * displacement) * sine
    );
    return Math.abs(goal - spring.value) + Math.abs(spring.velocity) / FREQUENCY;
  };

  function wakeName(name: HTMLElement, hero: HTMLElement) {
    const style = getComputedStyle(name);
    const restWeight = Number.parseFloat(style.fontWeight);
    const startSize = Number.parseFloat(style.fontSize);
    const lines = [...name.querySelectorAll<HTMLElement>(".hero-name-line")];
    const letters: Letter[] = [];

    name.setAttribute("aria-label", (name.textContent ?? "").replace(/\s+/gu, " ").trim());

    lines.forEach((line, lineIndex) => {
      const textNode = [...line.childNodes].find((node) => node.nodeType === Node.TEXT_NODE && node.textContent?.trim());
      if (!textNode) return;

      const lineBox = line.getBoundingClientRect();
      const raw = textNode.textContent ?? "";
      const text = raw.trim();
      const offset = raw.indexOf(text);
      const range = document.createRange();
      const word = document.createElement("span");
      word.className = "hero-name-word";
      word.setAttribute("aria-hidden", "true");

      // Measured from the real text before it is split, so the kerning survives and nothing shifts.
      [...text].forEach((character, index) => {
        range.setStart(textNode, offset + index);
        range.setEnd(textNode, offset + index + 1);
        const box = range.getBoundingClientRect();

        const element = document.createElement("span");
        element.className = "hero-letter";
        element.textContent = character;
        element.style.width = `${box.width / startSize}em`;
        word.append(element);

        letters.push({
          element,
          line: lineIndex,
          restX: (box.left + box.width / 2 - lineBox.left) / startSize,
          restY: (box.top + box.height / 2 - lineBox.top) / startSize,
          x: { value: 0, velocity: 0 },
          y: { value: 0, velocity: 0 },
          rotation: { value: 0, velocity: 0 },
          mass: 0.9 + box.width / startSize * 0.35,
          weight: { value: restWeight, velocity: 0 },
          tint: 0,
        });
      });

      textNode.replaceWith(word);
    });

    const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
    let visible = true;
    let size = startSize;
    let pointerTargetX = 0;
    let pointerTargetY = 0;
    let pointerX = 0;
    let pointerY = 0;
    let strength = 0;
    let strengthGoal = 0;
    let sweeping = false;
    let sweepTime = 0;
    let frame = 0;
    let lastTime = 0;
    let releaseTimer = 0;
    let introTimer = 0;
    let accumulator = 0;
    let pointerVelocityX = 0;
    let pointerVelocityY = 0;
    let lastPointerTime = 0;
    let touchStarted = 0;
    let touchActive = false;
    let lastScroll = window.scrollY;
    let scrollVelocity = 0;
    const scrollProgress = () => Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * (window.innerWidth >= 1024 ? 0.6 : 0.3))));
    const scrollSpring: Spring = { value: scrollProgress(), velocity: 0 };
    const renderScroll = () => {
      lines.forEach((line, i) => {
        line.style.translate = motionPreference.matches ? "" : `${-i * 0.9 * scrollSpring.value}em 0`;
      });
    };
    renderScroll();

    const settle = () => {
      cancelAnimationFrame(frame);
      window.clearTimeout(releaseTimer);
      window.clearTimeout(introTimer);
      frame = 0;
      sweeping = false;
      strengthGoal = 0;
      strength = 0;
      accumulator = 0;
      pointerVelocityX = pointerVelocityY = scrollVelocity = 0;
      lastPointerTime = 0;
      touchActive = false;
      lastScroll = window.scrollY;
      scrollSpring.value = scrollProgress();
      scrollSpring.velocity = 0;
      renderScroll();
      for (const letter of letters) {
        letter.x = { value: 0, velocity: 0 };
        letter.y = { value: 0, velocity: 0 };
        letter.rotation = { value: 0, velocity: 0 };
        letter.weight = { value: restWeight, velocity: 0 };
        letter.tint = 0;
        letter.element.style.removeProperty("translate");
        letter.element.style.removeProperty("rotate");
        letter.element.style.removeProperty("font-variation-settings");
        letter.element.style.removeProperty("--crest");
      }
    };

    const tick = (time: number) => {
      // Keeps the motion the same speed on 60Hz and 120Hz screens.
      const step = Math.min((time - lastTime) / 1000, 0.05) || 1 / 60;
      lastTime = time;

      const lineBoxes = lines.map((line) => line.getBoundingClientRect());
      // Substeps keep the coupled solver stable and independent of render frequency.
      accumulator += step;
      let restless = false;
      while (accumulator >= PHYSICS_STEP) {
        const dt = PHYSICS_STEP;
        accumulator -= dt;
        const reach = REACH_EM * size;
        if (sweeping) {
          sweepTime += dt;
          const row = Math.floor(sweepTime / 0.6);
          if (row >= lines.length) {
            sweeping = false;
            strengthGoal = 0;
          } else {
            const word = letters.filter((letter) => letter.line === row);
            const phase = (sweepTime % 0.6) / 0.6;
            const start = word[0].restX * size - reach;
            const end = word[word.length - 1].restX * size + reach;
            pointerX = lineBoxes[row].left + start + (end - start) * phase;
            pointerY = lineBoxes[row].top + word[0].restY * size;
          }
        } else if (strengthGoal > 0) {
          const blend = 1 - Math.exp(-24 * dt);
          pointerX += (pointerTargetX - pointerX) * blend;
          pointerY += (pointerTargetY - pointerY) * blend;
        }
        strength += (strengthGoal - strength) * (1 - Math.exp(-12 * dt));
        pull(scrollSpring, scrollProgress(), dt);
        pointerVelocityX *= Math.exp(-9 * dt);
        pointerVelocityY *= Math.exp(-9 * dt);
        scrollVelocity *= Math.exp(-10 * dt);

        const targets = letters.map((letter) => {
          const box = lineBoxes[letter.line];
          const dx = box.left + letter.restX * size - pointerX;
          const dy = box.top + letter.restY * size - pointerY;
          const distance = Math.hypot(dx, dy);
          const swell = Math.exp(-((distance / reach) ** 2));
          const wake = Math.exp(-((distance / (reach * WAKE_RATIO)) ** 2));
          const ratio = distance / (PUSH_REACH_EM * size);
          const push = strength * PUSH_EM * size * ratio * Math.exp(-(ratio ** 2));
          const press = touchActive ? Math.min((time - touchStarted) / 500, 1) : 0;
          pull(letter.weight, restWeight + strength * (SWELL_WEIGHT * swell - THIN_WEIGHT * wake), dt);
          letter.tint += (strength * swell * swell - letter.tint) * (1 - Math.exp(-20 * dt));
          return {
            x: distance ? dx / distance * push : 0,
            y: (distance ? dy / distance * push : 0) - strength * LIFT_EM * size * swell + press * size * 0.08 * swell,
            // Pointer drag and scroll inertia are external forces, not duration-based tweens.
            forceX: pointerVelocityX * 5 * swell * strength,
            forceY: pointerVelocityY * 5 * swell * strength + scrollVelocity * (1.5 + letter.line * 0.3),
          };
        });
        advanceChain(letters, targets, size);
      }
      renderScroll();
      restless = sweeping || touchActive || Math.abs(strengthGoal - strength) > 0.002 ||
        Math.abs(scrollSpring.value - scrollProgress()) + Math.abs(scrollSpring.velocity) > 0.0005 ||
        Math.abs(scrollVelocity) > 0.1 ||
        (strengthGoal > 0 && Math.hypot(pointerTargetX - pointerX, pointerTargetY - pointerY) > 0.1);
      for (const letter of letters) {
        restless ||= Math.abs(letter.x.velocity) + Math.abs(letter.y.velocity) + Math.abs(letter.rotation.velocity) + Math.abs(letter.weight.velocity) > 0.1;
        letter.element.style.translate = `${letter.x.value.toFixed(2)}px ${letter.y.value.toFixed(2)}px`;
        letter.element.style.rotate = `${letter.rotation.value.toFixed(3)}deg`;
        letter.element.style.fontVariationSettings = `"wght" ${Math.round(letter.weight.value)}`;
        letter.element.style.setProperty("--crest", letter.tint.toFixed(3));
      }

      if (restless) frame = requestAnimationFrame(tick);
      else if (strengthGoal === 0) settle();
      else frame = 0;
    };

    const run = () => {
      if (frame || !visible || document.hidden || motionPreference.matches) return;
      lastTime = performance.now();
      frame = requestAnimationFrame(tick);
    };

    const follow = (event: PointerEvent) => {
      if (motionPreference.matches || !visible) return;
      window.clearTimeout(introTimer);
      if (strengthGoal === 0 || sweeping) {
        pointerX = event.clientX;
        pointerY = event.clientY;
      }
      const now = performance.now();
      const elapsed = (now - lastPointerTime) / 1000;
      if (lastPointerTime && elapsed > 0 && elapsed < 0.1) {
        const limit = size * 14;
        pointerVelocityX = Math.max(-limit, Math.min(limit, (event.clientX - pointerTargetX) / elapsed));
        pointerVelocityY = Math.max(-limit, Math.min(limit, (event.clientY - pointerTargetY) / elapsed));
      }
      lastPointerTime = now;
      sweeping = false;
      pointerTargetX = event.clientX;
      pointerTargetY = event.clientY;
      strengthGoal = 1;
      run();
    };

    hero.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "touch") follow(event);
    });

    hero.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "touch") return;
      strengthGoal = 0;
      run();
    });

    const release = () => {
      window.clearTimeout(releaseTimer);
      touchActive = false;
      strengthGoal = 0;
      run();
    };
    window.addEventListener("pointerup", (event) => {
      if (event.pointerType === "touch") release();
    });
    window.addEventListener("pointercancel", release);
    window.addEventListener("blur", settle);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) settle();
    });
    motionPreference.addEventListener("change", settle);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) settle();
      else if (Math.abs(scrollSpring.value - scrollProgress()) > 0.001) run();
    }).observe(name);
    new ResizeObserver(() => {
      const nextSize = Number.parseFloat(getComputedStyle(name).fontSize);
      if (nextSize !== size) {
        size = nextSize;
        settle();
      }
    }).observe(name);

    // A touch has no hover to follow, so tapping the name swells it there for a moment.
    name.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "touch") return;
      follow(event);
      touchStarted = performance.now();
      touchActive = !motionPreference.matches;
      window.clearTimeout(releaseTimer);
      releaseTimer = window.setTimeout(() => {
        release();
      }, 1800);
    });

    // Scrolling releases the interaction so it never competes with reading.
    window.addEventListener(
      "scroll",
      () => {
        const delta = window.scrollY - lastScroll;
        lastScroll = window.scrollY;
        if (!visible || motionPreference.matches) return;
        scrollVelocity = Math.max(-size * 12, Math.min(size * 12, scrollVelocity + delta * 12));
        window.clearTimeout(introTimer);
        sweeping = false;
        release();
      },
      { passive: true },
    );

    // Leaving mid-swell must not come back that way from the back/forward cache.
    window.addEventListener("pagehide", () => {
      cancelAnimationFrame(frame);
      sweeping = false;
      strengthGoal = 0;
      settle();
    });

    // A wave crosses the name once on arrival, which also shows phones that it's alive.
    const [navigation] = performance.getEntriesByType("navigation") as PerformanceNavigationTiming[];
    if (navigation?.type !== "back_forward") {
      introTimer = window.setTimeout(() => {
        if (strengthGoal || !visible || document.hidden || motionPreference.matches) return;
        pointerX = name.getBoundingClientRect().left - REACH_EM * WAKE_RATIO * Number.parseFloat(getComputedStyle(name).fontSize);
        sweepTime = 0;
        sweeping = true;
        strengthGoal = 1;
        run();
      }, 500);
    }
  }

  const heroName = document.querySelector<HTMLElement>("#hero-name");
  const heroSection = heroName?.closest("section");

  if (heroName && heroSection) {
    // Letter positions are measured, so they have to be measured in the real font.
    document.fonts.ready.then(() => wakeName(heroName, heroSection));
  }
</script>

<style>
  .hero {
    display: grid;
    row-gap: 2.5rem;
    padding-block: 8rem 3rem;
  }

  .hero-name {
    font-size: var(--text-display);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  /* The letters are created in the browser, once the name is ready to answer the pointer. */
  .hero-name :global(.hero-name-word) {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-name :global(.hero-letter) {
    display: inline-block;
    white-space: pre;
    transform-origin: 50% 80%;
    color: color-mix(in oklch, var(--text-heading), var(--focus) calc(var(--crest, 0) * 100%));
  }

  /* Tracks match the header's 64/36 split, so the nav's links stand over the line and actions. */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 64fr) minmax(0, 36fr);
      column-gap: 3rem;
      align-content: end;
      align-items: end;
      min-height: 100svh;
      padding-block: 6rem 4.5rem;
    }

    /* Sits on the name's last line rather than its descenders. */
    .hero-side {
      padding-bottom: 0.5rem;
    }
  }
</style>
