---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../lib/seo";

const { level = 2 } = Astro.props as { level?: 1 | 2 };
const Heading = `h${level}` as "h1" | "h2";
const SubHeading = `h${level + 1}` as "h2" | "h3";

const facts = [
  { label: "Based in", value: "Myanmar" },
  { label: "Currently", value: "College student" },
  { label: "Focus", value: "Backend systems and distributed architecture" },
  { label: "Writes in", value: "English and Burmese" },
];

const stack = [
  { group: "Languages", tools: ["TypeScript", "JavaScript", "Python", "Go"] },
  { group: "Backend", tools: ["Node.js", "NestJS", "Express"] },
  { group: "Data & messaging", tools: ["PostgreSQL", "MongoDB", "Redis", "RabbitMQ"] },
  { group: "Frontend", tools: ["React", "Vue.js", "Astro", "Tailwind CSS"] },
  { group: "Tooling", tools: ["Docker", "Git", "Linux"] },
];

const profiles = [
  { label: "GitHub", href: siteConfig.social.github },
  { label: "LinkedIn", href: siteConfig.social.linkedin },
];
---

<!-- Split: the story on the wide column, the quick facts on the narrow one, then the stack as shelves. -->
<section id="about" aria-labelledby="about-heading" class="scroll-mt-[calc(var(--section-gap-l)*-1)] pb-(--section-gap) pt-(--section-gap-l)">
  <div class="about-split">
    <div>
      <Heading id="about-heading" class="text-section font-semibold leading-[1.02] tracking-[-0.04em] text-(--text-heading)">
        About
      </Heading>

      <div class="mt-10 max-w-[44rem] space-y-6">
        <p class="text-pretty text-lead leading-relaxed text-(--text-heading)">
          Hey, I’m Wint Khant Lin, also known as Happer. I’m a college student from Myanmar who’s deeply
          passionate about software engineering, especially backend systems, distributed architectures, and
          building tools that solve real problems.
        </p>

        <p class="text-pretty text-base leading-relaxed text-(--text-muted)">
          I started coding because I was curious about how things work under the hood. That curiosity turned
          into a love for over-engineering side projects, exploring system design, and learning in public.
          Every project I ship teaches me something new.
        </p>
      </div>
    </div>

    <aside class="about-facts" aria-label="Quick facts">
      <dl class="divide-y divide-(--border) border-y border-(--border)">
        {facts.map((fact) => (
          <div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5">
            <dt class="text-sm text-(--text-faint)">{fact.label}</dt>
            <dd class="text-sm text-(--text-heading)">{fact.value}</dd>
          </div>
        ))}
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5">
          <dt class="text-sm text-(--text-faint)">Elsewhere</dt>
          <dd class="flex flex-wrap gap-x-4">
            {profiles.map((profile) => (
              <a
                href={profile.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group -my-3 inline-flex min-h-11 items-center gap-1 text-sm text-(--text-heading) underline decoration-(--border-strong) underline-offset-4 transition-colors hover:decoration-(--text-heading)"
              >
                {profile.label}<span class="sr-only"> (opens in a new tab)</span>
                <Icon name="lucide:arrow-up-right" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
              </a>
            ))}
          </dd>
        </div>
      </dl>
    </aside>
  </div>

  <div class="mt-24">
    <SubHeading id="tools-heading" class="text-[clamp(1.5rem,2.2vw,2rem)] font-semibold leading-tight tracking-[-0.03em] text-(--text-heading)">
      Tools & technologies
    </SubHeading>

    <!-- Each group is a column of its tools, one per line, so the stack reads as a set of shelves rather than a run of slashes. -->
    <dl class="stack-grid mt-8" aria-labelledby="tools-heading">
      {stack.map((row) => (
        <div class="stack-group">
          <dt class="text-sm text-(--text-faint)">{row.group}</dt>
          <dd>
            <ul class="stack-tools">
              {row.tools.map((tool) => (
                <li class="text-lg leading-snug text-(--text-heading) sm:text-xl">{tool}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about-split {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .about-split {
      grid-template-columns: minmax(0, 64fr) minmax(0, 36fr);
      column-gap: 3rem;
      align-items: end;
    }
  }

  .stack-grid {
    display: grid;
    border-top: 1px solid var(--border);
  }

  /* Phones: one group per row, its tools stacked beside the label. */
  .stack-group {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .stack-group dd {
    margin-top: 0;
  }

  .stack-tools {
    display: grid;
    gap: 0.25rem;
  }

  @media (min-width: 1024px) {
    .stack-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-bottom: 1px solid var(--border);
    }

    .stack-group {
      display: block;
      border-bottom: 0;
      padding: 1.5rem 1.5rem 2rem;
    }

    .stack-group + .stack-group {
      border-left: 1px solid var(--border);
    }

    .stack-group:first-child {
      padding-left: 0;
    }

    .stack-group dd {
      margin-top: 1.25rem;
    }

    .stack-tools {
      gap: 0.5rem;
    }
  }
</style>
