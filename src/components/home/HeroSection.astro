---
import { Icon } from "astro-icon/components";
---

<section class="relative flex min-h-svh items-end overflow-hidden px-1 pb-20 pt-36 sm:px-2 lg:px-4">
  <div class="hero-intro-glow pointer-events-none absolute inset-x-0 top-0 h-[58%]"></div>

  <div class="relative z-10 w-full">
    <h1 class="max-w-310 text-balance font-serif text-[clamp(2.5rem,5.35vw,5.35rem)] font-normal leading-[1.05] tracking-[-0.035em] text-(--text-heading)">
      Hey! I'm Wint Khant Lin, a software engineer building reliable systems for useful products.
    </h1>

    <a href="mailto:hello@wintkhantlin.com" class="hero-cta group mt-9 inline-flex min-h-14 items-center gap-4 rounded-full px-6 text-base font-medium leading-none text-white transition-[transform,box-shadow,filter] duration-200 ease-out active:translate-y-0.5 sm:min-h-16 sm:gap-6 sm:px-8 sm:text-xl">
      <span class="relative z-10">Start a project with me</span>
      <span class="hero-cta-icon relative z-10 flex size-7 items-center justify-center" aria-hidden="true">
        <Icon name="lucide:play" class="size-4 fill-current transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
      </span>
    </a>
  </div>
</section>
