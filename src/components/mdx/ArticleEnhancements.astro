<div class="article-reading-progress" aria-hidden="true">
  <span data-reading-progress></span>
</div>

<script>
  const setupArticleProgress = () => {
    const article = document.querySelector<HTMLElement>(".article-page");
    const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
    if (!article || !progress) return;

    let progressFrame = 0;
    const updateProgress = () => {
      progressFrame = 0;
      const start = article.offsetTop;
      const distance = Math.max(article.offsetHeight - window.innerHeight, 1);
      const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      progress.style.transform = `scaleX(${value})`;
    };

    const requestProgressUpdate = () => {
      if (progressFrame) return;
      progressFrame = window.requestAnimationFrame(updateProgress);
    };

    window.addEventListener("scroll", requestProgressUpdate, { passive: true });
    window.addEventListener("resize", requestProgressUpdate);
    updateProgress();
  };

  setupArticleProgress();
</script>

<style is:global>
  .article-reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    display: none;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  .js .article-reading-progress {
    display: block;
  }

  .article-reading-progress > span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--focus);
  }

</style>
