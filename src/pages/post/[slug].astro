---
import { getSortedPosts, type PostEntry } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl, createAuthorSchema, createBreadcrumbSchema, siteConfig } from "../../lib/seo";
import profilePhoto from "../../assets/img/happer.png";
import { getImage, Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BackLink from "../../components/BackLink.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ArticleImage from "../../components/mdx/ArticleImage.astro";
import ArticleLink from "../../components/mdx/ArticleLink.astro";
import ArticleEnhancements from "../../components/mdx/ArticleEnhancements.astro";

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      nextPost: posts.length > 1 ? posts[(index + 1) % posts.length] : undefined,
      // The home page lists the three latest notes.
      onHome: index < 3,
    },
  }));
}

const { post, nextPost, onHome } = Astro.props as { post: PostEntry; nextPost?: PostEntry; onHome: boolean };
const Content = post.Content;
const description = post.data.description ?? post.data.summary ?? siteConfig.defaultDescription;
const metaDescription = post.data.seoDescription ?? description;
const publishedTime = post.data.publishedDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.publishedDate).toISOString();
const isMyanmar = /[\u1000-\u109F]/u.test(post.data.title);
const language = post.data.lang ?? (isMyanmar ? "my" : "en");
const canonicalPath = `/post/${post.id}`;
const canonicalUrl = absoluteUrl(canonicalPath, Astro.site);

const socialImage = post.data.cover
  ? await getImage({ src: post.data.cover, width: 1200, height: 630, format: "webp" })
  : { src: siteConfig.defaultImage };

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: metaDescription,
    image: absoluteUrl(socialImage.src, Astro.site),
    datePublished: publishedTime,
    dateModified: modifiedTime,
    inLanguage: language,
    author: createAuthorSchema(Astro.site),
    publisher: createAuthorSchema(Astro.site),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    keywords: post.data.categories,
  },
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "Notes", path: "/writing" },
      { name: post.data.title, path: canonicalPath },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={post.data.seoTitle ?? `${post.data.title} | ${siteConfig.siteName}`}
  description={metaDescription}
  canonicalPath={canonicalPath}
  image={socialImage.src}
  imageAlt={`${post.data.title} - ${siteConfig.author}`}
  keywords={[
    ...post.data.categories,
    "programming article",
    "software engineering blog",
  ]}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
  lang={language}
  locale={language === "my" ? "my_MM" : siteConfig.locale}
>
  <ArticleEnhancements />
  <div class="read-progress" aria-hidden="true"></div>
  <main id="main-content" class="mx-auto max-w-[50rem] px-5 pb-20 pt-32 sm:px-8 sm:pt-36">
    <nav class="mb-8" aria-label="Breadcrumb">
      <BackLink
        href="/writing"
        label="All notes"
        siblingPrefix="/post/"
        origins={[
          { path: "/", href: onHome ? `/#note-${post.id}` : "/#writing", label: "Back to notes" },
          { path: "/writing", href: `/writing#note-${post.id}`, label: "Back to all notes" },
        ]}
      />
    </nav>

    <article class="article-page font-sans">
      <header class="mb-10 border-b border-(--border) pb-10">
        <div class="mb-6 flex items-center gap-3">
          <Image
            src={profilePhoto}
            alt=""
            width={40}
            height={40}
            format="webp"
            class="size-10 rounded-md object-cover"
          />
          <div class="text-sm leading-5">
            <p class="font-semibold text-(--text-heading)">{siteConfig.author}</p>
            <p class="text-(--text-muted)">
              Posted on <time datetime={publishedTime}>
                {
                  post.data.publishedDate.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })
                }
              </time>
              {
                post.data.updatedDate && (
                  <>
                    <span aria-hidden="true"> · </span>
                    Updated <time datetime={modifiedTime}>
                      {post.data.updatedDate.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                  </>
                )
              }
            </p>
          </div>
        </div>

        <h1
          class:list={[
            "text-[clamp(2.25rem,5vw,3.25rem)] font-bold tracking-[-0.025em] text-(--text-heading)",
            isMyanmar ? "leading-[1.28]" : "leading-[1.12]",
          ]}
        >
          {post.data.title}
        </h1>

        <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-(--text-muted)" aria-label="Topics">
          {post.data.categories.map((category) => <span>#{category}</span>)}
        </div>

        {
          (post.data.description ?? post.data.summary) && (
            <p class="mt-7 text-lg leading-8 text-(--text-muted)">
              {post.data.description ?? post.data.summary}
            </p>
          )
        }
      </header>

      {
        post.data.cover && post.data.coverAlt && (
          <ArticleImage src={post.data.cover} alt={post.data.coverAlt} eager fit="cover" />
        )
      }

      <TableOfContents headings={post.headings} />

      <div
        class="article-body prose max-w-none text-[1.125rem] sm:text-xl
      prose-p:mb-7 prose-p:leading-[1.7] prose-p:text-(--text)

      prose-headings:font-bold
      prose-headings:tracking-[-0.02em]
      prose-h2:mb-4 prose-h2:mt-12 prose-h2:text-[1.75rem] prose-h2:leading-snug prose-h2:text-(--text-heading) sm:prose-h2:text-[1.9rem]
      prose-h3:mb-3 prose-h3:mt-9 prose-h3:text-[1.35rem] prose-h3:leading-snug prose-h3:text-(--text-heading) sm:prose-h3:text-2xl

      prose-strong:text-(--text-heading)

      prose-a:font-medium
      prose-a:text-(--article-link)
      prose-a:underline
      prose-a:decoration-current
      prose-a:underline-offset-[3px]
      hover:prose-a:no-underline

      prose-ul:text-(--text)
      prose-ol:text-(--text)
      prose-li:my-2 prose-li:leading-[1.65]

      prose-blockquote:border-l
      prose-blockquote:border-(--article-link)
      prose-blockquote:pl-5
      prose-blockquote:not-italic
      prose-blockquote:text-(--text)

      prose-img:my-10

      prose-th:text-(--text-heading)
      prose-td:text-(--text)

      prose-code:before:content-none
      prose-code:after:content-none

      prose-pre:overflow-x-auto"
      >
        <Content components={{ a: ArticleLink }} />
      </div>
    </article>

    <aside lang="en" class="mt-16 border-t border-(--border) pt-8" aria-label="About the author">
      <p class="text-base leading-relaxed text-(--text-muted)">
        <span class="font-semibold text-(--text-heading)">{siteConfig.author}</span> is a software engineer and college
        student from Myanmar, building reliable backend systems.{" "}
        <a
          href="/about"
          class="font-medium text-(--text-heading) underline decoration-(--border-strong) underline-offset-4 transition-[text-decoration-color] duration-200 hover:decoration-(--text-heading)"
        >
          More about me
        </a>
      </p>
    </aside>

    {nextPost && (
      <a href={`/post/${nextPost.id}`} class="group mt-12 block border-y border-(--border) py-12">
        <span lang="en" class="text-sm text-(--text-faint)">Next note</span>
        <div class="mt-4 flex items-end justify-between gap-8">
          <h2
            lang={nextPost.data.lang ?? (/[က-႟]/u.test(nextPost.data.title) ? "my" : "en")}
            class="font-sans text-[clamp(1.75rem,3vw,2.25rem)] font-semibold leading-[1.2] tracking-[-0.03em] text-(--text-heading)"
          >
            {nextPost.data.title}
          </h2>
          <Icon name="lucide:arrow-right" class="mb-1 size-6 shrink-0 text-(--text-heading) transition-transform duration-300 group-hover:translate-x-2" aria-hidden="true" />
        </div>
      </a>
    )}
  </main>
</BaseLayout>

<style>
  /* Goal-gradient: a hairline that fills as the note is read. Browsers without scroll-driven animation simply show nothing. */
  .read-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .read-progress {
        display: block;
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 60;
        height: 2px;
        background: var(--text-heading);
        transform: scaleX(0);
        transform-origin: left;
        animation: read-progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }
</style>
