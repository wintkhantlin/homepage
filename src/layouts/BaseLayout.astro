---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "./../styles/global.css";
import { Font } from "astro:assets";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { absoluteUrl, dedupeKeywords, siteConfig } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  canonicalPath?: string;
  keywords?: string[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  lang?: string;
  locale?: string;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  image = siteConfig.defaultImage,
  imageAlt = siteConfig.siteName,
  type = "website",
  canonicalPath,
  keywords = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  structuredData,
  lang = "en",
  locale = siteConfig.locale,
} = Astro.props as Props;

const pathname = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = Astro.site ? absoluteUrl(pathname, Astro.site) : undefined;
const imageUrl = image ? absoluteUrl(image, Astro.site) : undefined;
const twitterCard = image === siteConfig.defaultImage ? "summary" : "summary_large_image";
const metaKeywords = dedupeKeywords([...siteConfig.defaultKeywords, ...keywords]);
const structuredDataPayload = structuredData
  ? JSON.stringify(Array.isArray(structuredData) ? structuredData : [structuredData]).replace(/</gu, "\\u003c")
  : undefined;
---

<html lang={lang}>
  <head>
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.siteName} RSS feed`} href="/rss.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content={metaKeywords.join(", ")} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#0c0d0c" id="theme-color" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {type === "profile" && <meta property="profile:first_name" content={siteConfig.givenName} />}
    {type === "profile" && <meta property="profile:last_name" content={siteConfig.familyName} />}
    {type === "profile" && <meta property="profile:username" content={siteConfig.handle} />}
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={imageAlt} />}

    <GoogleAnalytics />
    {
      structuredDataPayload && (
        <script is:inline type="application/ld+json" set:html={structuredDataPayload} />
      )
    }
    <script is:inline>
      (function() {
        document.documentElement.classList.add('js');

        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') || 'dark';
        } catch {}

        const isLight = theme === 'light';
        document.documentElement.classList.toggle('light', isLight);
        document.documentElement.dataset.theme = isLight
          ? 'github-light-high-contrast'
          : 'github-dark-high-contrast';
        document.querySelector('#theme-color')?.setAttribute('content', isLight ? '#fafafa' : '#0c0d0c');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
