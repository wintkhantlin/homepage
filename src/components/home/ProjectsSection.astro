---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

type Project = Awaited<
  ReturnType<typeof import("../../lib/content").getSortedProjects>
>[number];

interface Props {
  projects: Project[];
  heading?: string;
  description?: string;
  showAllLink?: boolean;
  headingLevel?: "h1" | "h2";
}

const {
  projects,
  heading = "Selected work",
  description = "Systems-oriented products with the engineering decisions surfaced, not hidden behind screenshots.",
  showAllLink = false,
  headingLevel = "h2",
} = Astro.props as Props;

const Heading = headingLevel;

const maturityLabels = {
  built: "Built",
  prototype: "Prototype",
  "work-in-progress": "Work in progress",
} as const;

const contextLabels = {
  "open-source": "Open source",
  personal: "Personal project",
  hackathon: "Hackathon",
} as const;
---

<section id="projects" class="scroll-mt-28 py-24 sm:py-32">
  <div class="mb-16 grid gap-6 border-b border-(--border) pb-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <Heading class="font-serif text-[clamp(3.25rem,6vw,5.75rem)] font-normal leading-none tracking-[-0.04em] text-(--text-heading)">
        {heading}
      </Heading>
      <p class="mt-5 max-w-xl text-base leading-7 text-(--text-muted)">
        {description}
      </p>
    </div>
    <p class="text-sm text-(--text-faint)">
      {projects.length} {projects.length === 1 ? "project" : "projects"} documented
    </p>
  </div>

  <div>
    {projects.length > 0 ? projects.map((project) => (
      <article class="grid gap-7 border-b border-(--border) py-9 md:grid-cols-12 md:items-start md:gap-10 lg:py-14">
        <a
          href={`/project/${project.id}`}
          class="group overflow-hidden rounded-xl bg-(--border) md:col-span-7"
          aria-hidden="true"
          tabindex="-1"
        >
          <Image
            src={project.data.img}
            alt={`${project.data.name} product interface`}
            widths={[360, 640, 960, 1280]}
            sizes="(min-width: 1024px) 58vw, (min-width: 768px) 50vw, 100vw"
            width={1280}
            height={720}
            class="aspect-video h-auto w-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.025]"
          />
        </a>

        <div class="md:col-span-5">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold uppercase tracking-[0.12em] text-(--text-faint)">
            <span>{maturityLabels[project.data.maturity]}</span>
            <span aria-hidden="true">·</span>
            <span>{contextLabels[project.data.context]}</span>
            <span aria-hidden="true">·</span>
            <time datetime={project.data.publishedDate.toISOString()} class="tabular-nums">{project.data.publishedDate.getFullYear()}</time>
          </div>

          <h3 class="mt-5 text-4xl font-semibold tracking-[-0.04em] text-(--text-heading) sm:text-5xl">
            <a href={`/project/${project.id}`} class="transition-opacity duration-300 hover:opacity-60">
              {project.data.name}
            </a>
          </h3>

          <p class="mt-4 max-w-xl text-[15px] leading-7 text-(--text-muted)">
            {project.data.description}
          </p>

          <p class="mt-5 text-xs font-semibold uppercase tracking-[0.12em] text-(--text-faint)">
            Role · <span class="normal-case tracking-normal text-(--text-muted)">{project.data.role}</span>
          </p>

          <ul class="mt-5 space-y-3 border-l border-(--border) pl-4" aria-label={`${project.data.name} engineering evidence`}>
            {project.data.proofPoints.map((point) => (
              <li class="text-sm leading-6 text-(--text-muted)">{point}</li>
            ))}
          </ul>

          {project.data.technologies && (
            <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2" aria-label={`${project.data.name} technologies`}>
              {project.data.technologies.slice(0, 5).map((technology) => (
                <li class="text-xs text-(--text-faint)">{technology}</li>
              ))}
            </ul>
          )}

          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a
              href={`/project/${project.id}`}
              class="group inline-flex min-h-11 items-center gap-3 rounded-full bg-(--text-heading) px-5 text-sm font-semibold text-(--bg) transition-transform duration-300 hover:-translate-y-0.5 active:translate-y-0"
              aria-hidden="true"
              tabindex="-1"
            >
              Read case study
              <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a
              href={project.data.source}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading)"
            >
              Source
              <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </div>
        </div>
      </article>
    )) : (
      <p class="border-y border-(--border) py-12 text-base leading-7 text-(--text-muted)">
        No project case studies are published yet. Check back soon.
      </p>
    )}
  </div>

  {showAllLink && (
    <div class="flex justify-end pt-8">
      <a
        href="/projects"
        class="group inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-(--text-muted) transition-colors hover:text-(--text-heading)"
      >
        View all projects
        <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  )}
</section>
