---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkIndex from "../components/home/WorkIndex.astro";
import { getSortedProjects } from "../lib/content";
import { createBreadcrumbSchema, siteConfig } from "../lib/seo";
import profilePhoto from "../assets/img/happer.png";
import { getImage } from "astro:assets";

const [projects, socialImage] = await Promise.all([
  getSortedProjects(),
  getImage({
    src: profilePhoto,
    width: 1200,
    height: 630,
    format: "webp",
  }),
]);

const title = `Software Projects & Case Studies | ${siteConfig.siteName}`;
const description =
  "Explore Wint Khant Lin's software projects, including backend systems, distributed architectures, open-source builds, and technical experiments.";
const structuredData = createBreadcrumbSchema(
  [
    { name: "Home", path: "/" },
    { name: "Work", path: "/projects" },
  ],
  Astro.site,
);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/projects"
  image={socialImage.src}
  imageAlt="Wint Khant Lin software projects"
  keywords={["software projects", "backend case studies", "distributed systems portfolio"]}
  structuredData={structuredData}
>
  <main id="main-content" class="mx-auto w-full max-w-7xl px-5 pb-24 pt-36 text-(--text) sm:px-6 md:px-8">
    <header class="pb-12">
      <h1 class="font-sans text-[clamp(3rem,6.4vw,4.5rem)] font-semibold leading-none tracking-[-0.04em] text-(--text-heading)">
        Work
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-(--text-muted)">
        Open-source builds, product experiments, and hackathon work, with maturity and architectural evidence made explicit.
      </p>
    </header>

    <WorkIndex projects={projects} />
  </main>
</BaseLayout>
