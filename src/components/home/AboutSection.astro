---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../lib/seo";

const facts = [
  { label: "Based in", value: "Myanmar" },
  { label: "Currently", value: "College student" },
  { label: "Focus", value: "Backend systems and distributed architecture" },
  { label: "Writes in", value: "English and Burmese" },
];

const stack = [
  { group: "Languages", tools: ["TypeScript", "JavaScript", "Python", "Go"] },
  { group: "Backend", tools: ["Node.js", "NestJS", "Express"] },
  { group: "Data & messaging", tools: ["PostgreSQL", "MongoDB", "Redis", "RabbitMQ"] },
  { group: "Frontend", tools: ["React", "Vue.js", "Astro", "Tailwind CSS"] },
  { group: "Tooling", tools: ["Docker", "Git", "Linux"] },
];

const profiles = [
  { label: "GitHub", href: siteConfig.social.github },
  { label: "LinkedIn", href: siteConfig.social.linkedin },
];
---

<section id="about" class="scroll-mt-28 pb-24 pt-12 sm:pb-32 sm:pt-16">
  <div class="mb-10 border-b border-(--border) pb-6">
    <h2 class="font-sans text-[clamp(2rem,3vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-(--text-heading)">
      About
    </h2>
  </div>

  <div class="grid gap-12 md:grid-cols-12 md:gap-10">
    <aside class="md:col-span-4" aria-label="Quick facts">
      <dl class="-mt-3.5 divide-y divide-(--border) border-b border-(--border)">
        {facts.map((fact) => (
          <div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5">
            <dt class="text-sm text-(--text-faint)">{fact.label}</dt>
            <dd class="text-sm text-(--text-heading)">{fact.value}</dd>
          </div>
        ))}
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-3.5">
          <dt class="text-sm text-(--text-faint)">Elsewhere</dt>
          <dd class="flex flex-wrap gap-x-4">
            {profiles.map((profile) => (
              <a
                href={profile.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group -my-3 inline-flex min-h-11 items-center gap-1 text-sm text-(--text-heading) underline decoration-(--border-strong) underline-offset-4 transition-colors hover:decoration-(--text-heading)"
              >
                {profile.label}<span class="sr-only"> (opens in a new tab)</span>
                <Icon name="lucide:arrow-up-right" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
              </a>
            ))}
          </dd>
        </div>
      </dl>
    </aside>

    <div class="max-w-[65ch] space-y-5 md:col-span-7 md:col-start-6">
      <p class="text-lg leading-relaxed text-(--text-heading)">
        Hey, I'm Wint Khant Lin, also known as Happer. I'm a college student from Myanmar who's deeply
        passionate about software engineering, especially backend systems, distributed architectures, and
        building tools that solve real problems.
      </p>

      <p class="text-base leading-relaxed text-(--text-muted)">
        I started coding because I was curious about how things work under the hood. That curiosity turned
        into a love for over-engineering side projects, exploring system design, and learning in public.
        Every project I ship teaches me something new.
      </p>

      <p class="text-base leading-relaxed text-(--text-muted)">
        When I'm not coding, I'm probably listening to music, reading about software architecture, or
        planning my next experiment. I believe in the power of documenting the journey: sharing the
        process, not just the results.
      </p>

      <p class="text-base leading-relaxed text-(--text-muted)">
        I'm always open to connecting with fellow developers, collaborating on interesting projects, or
        just having a conversation about tech. Feel free to reach out.
      </p>
    </div>
  </div>

  <div class="mt-20">
    <h3 class="border-b border-(--border) pb-4 text-xl font-semibold tracking-[-0.02em] text-(--text-heading) sm:text-2xl">
      Tools & technologies
    </h3>

    <dl>
      {stack.map((row) => (
        <div class="grid gap-1 border-b border-(--border) py-4 md:grid-cols-12 md:items-baseline md:gap-10">
          <dt class="text-sm text-(--text-faint) md:col-span-4">{row.group}</dt>
          <dd class="flex flex-wrap items-baseline text-base text-(--text-heading) md:col-span-8">
            {row.tools.map((tool, index) => (
              <>
                {index > 0 && <span class="mx-2 text-(--text-faint)" aria-hidden="true">/</span>}
                <span class="whitespace-nowrap">{tool}</span>
                {index < row.tools.length - 1 && <span class="sr-only">, </span>}
              </>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
