---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import CaseStudy from "../../components/project/CaseStudy.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedProjects, type ProjectEntry } from "../../lib/content";
import { absoluteUrl, createBreadcrumbSchema, siteConfig } from "../../lib/seo";

interface Props {
  project: ProjectEntry;
  nextProject?: ProjectEntry;
}

export async function getStaticPaths() {
  const projects = await getSortedProjects();

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : undefined,
    },
  }));
}

const { project, nextProject } = Astro.props as Props;
const Content = project.Content;
const caseStudy = project.data.caseStudy;
const maturityLabels = {
  built: "Built",
  prototype: "Prototype",
  "work-in-progress": "Work in progress",
} as const;
const canonicalPath = `/project/${project.id}`;
const metaTitle = project.data.seoTitle ?? `${project.data.name} Case Study | ${siteConfig.siteName}`;
const metaDescription = project.data.seoDescription ?? project.data.description;
const socialImage = await getImage({
  src: project.data.img,
  width: 1200,
  format: "webp",
});
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: project.data.name,
    description: metaDescription,
    url: absoluteUrl(canonicalPath, Astro.site),
    image: absoluteUrl(socialImage.src, Astro.site),
    mainEntityOfPage: absoluteUrl(canonicalPath, Astro.site),
    codeRepository: project.data.source,
    dateCreated: project.data.publishedDate.toISOString(),
    programmingLanguage: project.data.technologies,
    author: {
      "@type": "Person",
      "@id": absoluteUrl("/#person", Astro.site),
      name: siteConfig.author,
      url: absoluteUrl("/", Astro.site),
    },
  },
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "Projects", path: "/projects" },
      { name: project.data.name, path: canonicalPath },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath={canonicalPath}
  image={socialImage.src}
  imageAlt={`${project.data.name} product interface`}
  keywords={[...(project.data.technologies || []), project.data.type || "software project", "software case study"]}
  structuredData={structuredData}
>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-7xl px-5 pb-24 pt-36 text-(--text) sm:px-6 md:px-8">
    <a href="/projects" class="group inline-flex min-h-11 items-center gap-2 text-sm text-(--text-muted) transition-colors hover:text-(--text-heading) active:text-(--text-heading)">
      <Icon name="lucide:arrow-left" class="size-4 transition-transform duration-300 group-hover:-translate-x-1" />
      All projects
    </a>

    <header class="pb-16 pt-16 md:pb-20 md:pt-24">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[0.14em] text-(--text-faint)">
        <span>{project.data.type || "Product"}</span>
        <span aria-hidden="true">·</span>
        <time datetime={project.data.publishedDate.toISOString()} class="tabular-nums">{project.data.publishedDate.getFullYear()}</time>
        {caseStudy?.status && (
          <>
            <span aria-hidden="true">·</span>
            <span>{caseStudy.status}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{maturityLabels[project.data.maturity]}</span>
      </div>

      <p class="mt-4 text-sm text-(--text-muted)">
        <span class="text-(--text-faint)">My role</span>
        <span class="ml-2 text-(--text-heading)">{project.data.role}</span>
      </p>

      <h1 class="mt-7 max-w-5xl font-sans text-[clamp(3rem,6.4vw,4.5rem)] font-semibold leading-[1] tracking-[-0.04em] text-(--text-heading)">
        {project.data.name}
      </h1>

      <p class="mt-9 max-w-3xl text-lg leading-relaxed text-(--text-muted)">
        {project.data.description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={project.data.source}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-12 w-fit items-center gap-3 rounded-full bg-(--text-heading) px-6 text-sm font-semibold text-(--bg) transition-colors duration-300 hover:bg-(--text)"
        >
          GitHub repository<span class="sr-only"> (opens in a new tab)</span>
          <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
        </a>
        {project.data.demo && (
          <a
            href={project.data.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading)"
          >
            Live demo<span class="sr-only"> (opens in a new tab)</span>
            <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
          </a>
        )}
      </div>

      <section class="mt-16 border-t border-(--border) pt-6" aria-labelledby="engineering-highlights">
        <h2 id="engineering-highlights" class="text-sm font-semibold text-(--text-heading)">Engineering highlights</h2>
        <ol class="mt-6 grid gap-8 md:grid-cols-2 md:gap-10">
          {project.data.proofPoints.map((point, index) => (
            <li>
              <h3 class="text-xl font-semibold tracking-[-0.02em] text-(--text-heading)">
                <span class="mr-2 font-mono text-sm font-normal tabular-nums text-(--text-faint)">{String(index + 1).padStart(2, "0")} /</span>
                {point.title}
              </h3>
              <p class="mt-2 max-w-[52ch] text-base leading-relaxed text-(--text-muted)">{point.detail}</p>
            </li>
          ))}
        </ol>
      </section>
    </header>

    <figure class="overflow-hidden rounded-2xl bg-(--border)">
      <Image
        src={project.data.img}
        alt={`${project.data.name} product interface`}
        widths={[400, 720, 1024, 1280]}
        sizes="(max-width: 1280px) 100vw, 1280px"
        class="aspect-video h-auto w-full object-contain"
      />
    </figure>

    <div class="grid gap-16 py-24 md:grid-cols-12 md:gap-10 lg:py-32">
      <aside class="md:col-span-4">
        <div class="md:sticky md:top-32">
          <h2 class="text-sm font-semibold text-(--text-heading)">
            Technology
          </h2>
          {project.data.technologies?.length ? (
            <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-(--border) pt-5 sm:grid-cols-3 md:grid-cols-1">
              {project.data.technologies.map((technology) => (
                <li class="text-sm text-(--text-muted)">{technology}</li>
              ))}
            </ul>
          ) : (
            <p class="mt-5 border-t border-(--border) pt-5 text-sm leading-6 text-(--text-muted)">
              Technology details are available in the source repository.
            </p>
          )}
          <p class="mt-9 max-w-xs text-xs leading-5 text-(--text-faint)">
            This case study reflects the project documentation and current source repository.
          </p>
        </div>
      </aside>

      <div class="md:col-span-8">
        {caseStudy ? (
          <CaseStudy
            diagram={caseStudy.diagram}
            challenge={caseStudy.challenge}
            approach={caseStudy.approach}
            architecture={caseStudy.architecture}
            highlights={caseStudy.highlights}
          />
        ) : (
          <section>
            <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">Project overview</h2>
            <p class="mt-6 max-w-[68ch] text-base leading-8 text-(--text-muted) sm:text-lg">
              {project.data.description}
            </p>
          </section>
        )}

        {project.body && (
          <section class="prose mt-20 max-w-[68ch] prose-p:leading-7 prose-p:text-(--text-muted) prose-headings:font-medium prose-headings:tracking-[-0.02em] prose-headings:text-(--text-heading) prose-strong:text-(--text-heading) prose-ul:text-(--text-muted) prose-ol:text-(--text-muted) prose-code:rounded-md prose-code:bg-(--border) prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.9em] prose-code:text-(--text-heading)">
            <Content />
          </section>
        )}
      </div>
    </div>

    {nextProject && (
      <a href={`/project/${nextProject.id}`} class="group block border-y border-(--border) py-12 sm:py-16">
        <span class="text-sm text-(--text-faint)">Next case study</span>
        <div class="mt-4 flex items-end justify-between gap-8">
          <h2 class="font-sans text-[clamp(2rem,3vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-(--text-heading)">
            {nextProject.data.name}
          </h2>
          <Icon name="lucide:arrow-right" class="mb-1 size-6 shrink-0 text-(--text-heading) transition-transform duration-300 group-hover:translate-x-2" />
        </div>
      </a>
    )}
  </main>
</BaseLayout>
