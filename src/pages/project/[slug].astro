---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import BackLink from "../../components/BackLink.astro";
import ProjectName from "../../components/ProjectName.astro";
import CaseStudy from "../../components/project/CaseStudy.astro";
import ProjectRail from "../../components/project/ProjectRail.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedProjects, type ProjectEntry } from "../../lib/content";
import { absoluteUrl, createAuthorSchema, createBreadcrumbSchema, siteConfig } from "../../lib/seo";

interface Props {
  project: ProjectEntry;
  nextProject?: ProjectEntry;
}

export async function getStaticPaths() {
  const projects = await getSortedProjects();

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : undefined,
    },
  }));
}

const { project, nextProject } = Astro.props as Props;
const Content = project.Content;
const caseStudy = project.data.caseStudy;

// Diagrams are pre-rendered to SVG by `npm run diagrams` (scripts/render-diagrams.mjs).
const diagramSvgs = import.meta.glob<string>("../../generated/diagrams/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
function diagramSvg(theme: "light" | "dark") {
  const path = `../../generated/diagrams/${project.id}.${theme}.svg`;
  if (!diagramSvgs[path]) throw new Error(`Missing ${path}. Run "npm run diagrams" and commit the output.`);
  return diagramSvgs[path];
}

const maturityLabels = {
  built: "Built",
  prototype: "Prototype",
  "work-in-progress": "Work in progress",
} as const;
const projectType = project.data.type || "Product";
const maturity = maturityLabels[project.data.maturity];
const facts: { label: string; value: string; datetime?: string }[] = [
  { label: "My role", value: project.data.role },
  { label: "Type", value: projectType.charAt(0).toUpperCase() + projectType.slice(1) },
  {
    label: "Year",
    value: String(project.data.publishedDate.getFullYear()),
    datetime: project.data.publishedDate.toISOString(),
  },
  ...(caseStudy?.status && caseStudy.status !== maturity ? [{ label: "Context", value: caseStudy.status }] : []),
  { label: "Stage", value: maturity },
];
// Each id matches a section in CaseStudy.astro.
const caseStudySections = [
  { id: "the-challenge", label: "The challenge" },
  { id: "the-approach", label: "The approach" },
  { id: "system-architecture", label: "System architecture" },
  { id: "how-it-is-structured", label: "How it is structured" },
  { id: "what-it-includes", label: "What it includes" },
];
const canonicalPath = `/project/${project.id}`;
const metaTitle = project.data.seoTitle ?? `${project.data.name} Case Study | ${siteConfig.siteName}`;
const metaDescription = project.data.seoDescription ?? project.data.description;
const socialImage = await getImage({
  src: project.data.img,
  width: 1200,
  format: "webp",
});
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: project.data.name,
    description: metaDescription,
    url: absoluteUrl(canonicalPath, Astro.site),
    image: absoluteUrl(socialImage.src, Astro.site),
    mainEntityOfPage: absoluteUrl(canonicalPath, Astro.site),
    codeRepository: project.data.source,
    dateCreated: project.data.publishedDate.toISOString(),
    programmingLanguage: project.data.technologies,
    author: createAuthorSchema(Astro.site),
  },
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "Work", path: "/projects" },
      { name: project.data.name, path: canonicalPath },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath={canonicalPath}
  image={socialImage.src}
  imageAlt={`${project.data.name} product interface`}
  keywords={[...(project.data.technologies || []), project.data.type || "software project", "software case study"]}
  structuredData={structuredData}
>
  <main id="main-content" class="mx-auto max-w-7xl px-5 pb-24 pt-(--page-top) text-(--text) sm:px-6 md:px-8">
    <BackLink
      href="/projects"
      label="All work"
      siblingPrefix="/project/"
      origins={[
        { path: "/", href: project.data.featured ? `/#work-${project.id}` : "/#projects", label: "Back to selected work" },
        { path: "/projects", href: `/projects#work-${project.id}`, label: "Back to all work" },
      ]}
    />

    <header class="pb-10 pt-10 md:pb-12 md:pt-14">
      <ProjectName
        as="h1"
        name={project.data.name}
        slug={project.id}
        class="max-w-5xl font-sans text-[clamp(3rem,6.4vw,4.5rem)] font-semibold tracking-[-0.04em] text-(--text-heading)"
      />

      <p class="mt-9 max-w-3xl text-lg leading-relaxed text-(--text-muted)">
        {project.data.description}
      </p>

      <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-4 text-sm sm:flex sm:flex-wrap sm:gap-x-10">
        {facts.map((fact, index) => (
          <div class:list={[index === 0 && "col-span-2 sm:col-span-1"]}>
            <dt class="text-(--text-faint)">{fact.label}</dt>
            <dd class="mt-1 text-(--text-heading)">
              {fact.datetime ? <time datetime={fact.datetime} class="tabular-nums">{fact.value}</time> : fact.value}
            </dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={project.data.source}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-12 w-fit items-center gap-3 rounded-full bg-(--text-heading) px-6 text-sm font-semibold text-(--bg) transition-colors duration-300 hover:bg-(--text)"
        >
          GitHub repository<span class="sr-only"> (opens in a new tab)</span>
          <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
        </a>
        {project.data.demo && (
          <a
            href={project.data.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-(--text-muted) transition-colors hover:text-(--text-heading)"
          >
            Live demo<span class="sr-only"> (opens in a new tab)</span>
            <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
          </a>
        )}
      </div>
    </header>

    <figure class="overflow-hidden rounded-2xl bg-(--border)">
      <Image
        src={project.data.img}
        alt={`${project.data.name} product interface`}
        widths={[400, 720, 1024, 1280]}
        sizes="(max-width: 1280px) 100vw, 1280px"
        class="aspect-video h-auto w-full object-contain"
      />
    </figure>

    <section class="mt-16 border-t border-(--border) pt-6 md:mt-20" aria-labelledby="engineering-highlights">
      <h2 id="engineering-highlights" class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">Engineering highlights</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-2 md:gap-10">
        {project.data.proofPoints.map((point, index) => (
          <li>
            <h3 class="text-xl font-semibold tracking-[-0.02em] text-(--text-heading)">
              <span class="mr-2 font-mono text-sm font-normal tabular-nums text-(--text-faint)">{String(index + 1).padStart(2, "0")} /</span>
              {point.title}
            </h3>
            <p class="mt-2 max-w-[52ch] text-base leading-relaxed text-(--text-muted)">{point.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="pb-24 pt-16 lg:pb-32 lg:pt-20">
      {caseStudy ? (
        <CaseStudy
          diagramLight={diagramSvg("light")}
          diagramDark={diagramSvg("dark")}
          challenge={caseStudy.challenge}
          approach={caseStudy.approach}
          architecture={caseStudy.architecture}
          highlights={caseStudy.highlights}
          technologies={project.data.technologies}
          sections={caseStudySections}
        >
          {project.body && (
            <section class="prose mt-20 max-w-[40rem] prose-p:leading-7 prose-p:text-(--text-muted) prose-headings:font-medium prose-headings:tracking-[-0.02em] prose-headings:text-(--text-heading) prose-strong:text-(--text-heading) prose-ul:text-(--text-muted) prose-ol:text-(--text-muted) prose-code:rounded-md prose-code:bg-(--border) prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.9em] prose-code:text-(--text-heading)">
              <Content />
            </section>
          )}
        </CaseStudy>
      ) : (
        <div class="grid gap-16 md:grid-cols-12 md:gap-10">
          <ProjectRail class="md:col-span-4 lg:col-span-3" technologies={project.data.technologies} />
          <div class="md:col-span-8 lg:col-span-9">
            <section>
              <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">Project overview</h2>
              <p class="mt-6 max-w-[40rem] text-base leading-8 text-(--text-muted) sm:text-lg">
                {project.data.description}
              </p>
            </section>
          </div>
        </div>
      )}
    </div>

    {nextProject && (
      <a href={`/project/${nextProject.id}`} class="group block border-y border-(--border) py-12 sm:py-16">
        <span class="text-sm text-(--text-faint)">Next case study</span>
        <div class="mt-4 flex items-end justify-between gap-8">
          <h2 class="font-sans text-[clamp(2rem,3vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-(--text-heading)">
            {nextProject.data.name}
          </h2>
          <Icon name="lucide:arrow-right" class="mb-1 size-6 shrink-0 text-(--text-heading) transition-transform duration-300 group-hover:translate-x-2" />
        </div>
      </a>
    )}
  </main>
</BaseLayout>

<script>
  // Marks the rail link whose section is crossing the reading line, and keeps it marked through the gaps between sections.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-case-link]")];
  const sections = links
    .map((link) => document.getElementById(link.dataset.caseLink ?? ""))
    .filter((section): section is HTMLElement => Boolean(section));

  if (sections.length && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            if (link.dataset.caseLink === entry.target.id) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
