---
import CopyEmailButton from "./CopyEmailButton.astro";

const pathname = Astro.url.pathname;
const siteLinks = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/projects" },
  { label: "Notes", href: "/writing" },
  { label: "About", href: "/about" },
];
const contactLinks = [
  { label: "wintkhantlin@gmail.com", href: "mailto:wintkhantlin@gmail.com" },
  { label: "GitHub", href: "https://github.com/wintkhantlin", external: true },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/wintkhantlin/", external: true },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href === "/about") return pathname === "/about";
  if (href === "/writing") return pathname === "/writing" || pathname.startsWith("/post/");
  if (href === "/projects") return pathname === "/projects" || pathname.startsWith("/project/");
  return false;
};
---

<!-- Colophon: the close as plain contact lines, then the site's links and one paragraph of credits. -->
<footer lang="en" class="border-t border-(--border)">
  <div class="mx-auto w-full max-w-7xl px-5 pb-10 pt-(--section-gap-s) sm:px-6 md:px-8">
    <!--email_off-->
    <section class="footer-close" aria-labelledby="say-hello">
      <div>
        <h2 id="say-hello" class="text-display-s font-semibold leading-none tracking-[-0.04em] text-(--text-heading)">
          Say hello.
        </h2>
        <p class="mt-5 text-lead text-(--text-muted)">Hiring, collaborating, or just curious?</p>
      </div>

      <ul class="footer-contact" aria-label="Contact">
        {contactLinks.map((link) => (
          <li class="flex flex-wrap items-center">
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="inline-flex min-h-11 items-center text-lg text-(--text-heading) underline decoration-(--border-strong) underline-offset-[0.3em] transition-[text-decoration-color] duration-200 hover:decoration-(--text-heading) sm:text-xl"
            >
              {link.label}
              {link.external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
            {link.href.startsWith("mailto:") && <CopyEmailButton email={link.label} class="ml-2" />}
          </li>
        ))}
      </ul>
    </section>
    <!--/email_off-->

    <div class="footer-colophon">
      <nav aria-label="Footer navigation">
        <ul class="-ml-1.5 flex flex-wrap gap-x-3">
          {siteLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="inline-flex min-h-11 items-center px-1.5 text-sm text-(--text-muted) transition-colors duration-200 hover:text-(--text-heading) aria-[current=page]:text-(--text-heading)"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="ml-auto pr-1.5">
            <a
              href="#main-content"
              class="inline-flex min-h-11 items-center text-sm text-(--text-muted) underline decoration-(--border-strong) underline-offset-[0.3em] transition-colors duration-200 hover:text-(--text-heading) hover:decoration-(--text-heading)"
            >
              Back to top
            </a>
          </li>
        </ul>
      </nav>

      <p class="max-w-[40rem] text-sm leading-relaxed text-(--text-faint)">
        <span class="tabular-nums">&copy; {new Date().getFullYear()}</span> Wint Khant Lin
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-close {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 4rem;
  }

  .footer-contact {
    display: grid;
    gap: 0.25rem;
  }

  .footer-colophon {
    display: grid;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  /* The same 64/36 split as the hero and the nav. */
  @media (min-width: 1024px) {
    .footer-close {
      grid-template-columns: minmax(0, 64fr) minmax(0, 36fr);
      column-gap: 3rem;
      align-items: end;
      padding-bottom: 6rem;
    }

    .footer-colophon {
      grid-template-columns: minmax(0, 64fr) minmax(0, 36fr);
      column-gap: 3rem;
      align-items: center;
    }
  }
</style>
