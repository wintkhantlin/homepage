---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import WorkIndex from "../components/home/WorkIndex.astro";
import RecognitionSection from "../components/home/RecognitionSection.astro";
import WritingSection from "../components/home/WritingSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
import profilePhoto from "../assets/img/happer.png";
import { getImage } from "astro:assets";
import { getFeaturedProjects, getSortedPosts } from "../lib/content";
import { createPersonSchema, createWebsiteSchema, siteConfig } from "../lib/seo";

const [projects, posts] = await Promise.all([
  getFeaturedProjects(),
  getSortedPosts(),
]);
const profileImage = await getImage({
  src: profilePhoto,
  width: 1200,
  height: 900,
  format: "webp",
});
const structuredData = [
  createPersonSchema(Astro.site, profileImage.src),
  createWebsiteSchema(Astro.site),
];
---

<BaseLayout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
  canonicalPath="/"
  image={profileImage.src}
  imageAlt="Wint Khant Lin, software engineer"
  type="profile"
  structuredData={structuredData}
>
  <main id="main-content" class="mx-auto w-full max-w-7xl px-5 text-(--text) sm:px-6 md:px-8">
    <HeroSection />
    <WorkIndex projects={projects} heading="Selected work" />
    <RecognitionSection />
    <WritingSection posts={posts} />
    <AboutSection showTools={false} />
  </main>
</BaseLayout>
