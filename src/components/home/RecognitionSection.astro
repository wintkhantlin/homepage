---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import gustoMedals from "../../assets/img/awards/gusto-innovation-golden-metals.png";
import gustoWinnerPose from "../../assets/img/awards/gusto-innovation-winner-pose.png";
import gustoProjectDisplay from "../../assets/img/awards/polo-gusto-innovation-1.jpeg";
import letsTechWinnerPose from "../../assets/img/awards/lets-tech-hackathon-winner-pose.png";

interface RecognitionImage {
  src: ImageMetadata;
  alt: string;
  renderWidth: number;
}

interface Recognition {
  result: string;
  event: string;
  datetime: string;
  date: string;
  images?: RecognitionImage[];
}

const recognitions: Recognition[] = [
  {
    result: "First runner-up",
    event: "GUSTO Innovation Awards & Forum 2026",
    datetime: "2026-08",
    date: "August 2026",
    images: [
      {
        src: gustoWinnerPose,
        alt: "Wint holding first runner-up and social media award boards at the GUSTO Innovation Awards & Forum",
        renderWidth: 420,
      },
      {
        src: gustoMedals,
        alt: "Two gold GUSTO College award medals held in one hand",
        renderWidth: 240,
      },
      {
        src: gustoProjectDisplay,
        alt: "The team's secured recommerce marketplace display at the GUSTO Innovation Awards & Forum",
        renderWidth: 320,
      },
    ],
  },
  {
    result: "Winner",
    event: "Let's Tech 2026: Agentic Edition",
    datetime: "2026-07",
    date: "July 2026",
    images: [
      {
        src: letsTechWinnerPose,
        alt: "Wint holding the Let's Tech Hackathon winner board",
        renderWidth: 320,
      },
    ],
  },
  {
    result: "Winner",
    event: "GUSTO Technical Competition 2026",
    datetime: "2026-01",
    date: "January 2026",
  },
];
---

<section aria-labelledby="recognition-heading" class="pb-24 sm:pb-32">
  <div class="grid gap-6 border-b border-(--border) pb-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-(--text-faint)">
        Recognition
      </p>
      <h2
        id="recognition-heading"
        class="font-serif text-[clamp(3.25rem,6vw,5.75rem)] font-normal leading-none tracking-[-0.04em] text-(--text-heading)"
      >
        Competition results
      </h2>
    </div>
    <p class="font-mono text-sm tabular-nums text-(--text-faint)">2026</p>
  </div>

  <ol>
    {
      recognitions.map((recognition, index) => (
        <li
          class:list={["recognition-row", { "recognition-row--preview": recognition.images }]}
        >
          <span class="font-mono text-xs tabular-nums text-(--text-faint)" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <p class="text-sm font-semibold text-(--text-heading)">{recognition.result}</p>
          <p class="max-w-2xl text-base leading-7 text-(--text-muted)">{recognition.event}</p>
          <time
            datetime={recognition.datetime}
            class="font-mono text-xs tabular-nums text-(--text-faint) md:text-right"
          >
            {recognition.date}
          </time>

          {recognition.images && (
            <aside
              class:list={["award-preview", { "award-preview--gallery": recognition.images.length > 1 }]}
              aria-label={`${recognition.event} photographs`}
            >
              {recognition.images.map((image) => (
                <figure>
                  <Image
                    src={image.src}
                    alt={image.alt}
                    width={image.renderWidth}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </figure>
              ))}
            </aside>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .recognition-row {
    position: relative;
    display: grid;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-block: 1.75rem;
  }


  .award-preview {
    display: none;
  }

  @media (min-width: 768px) {
    .recognition-row {
      grid-template-columns: 2.5rem minmax(9rem, 0.7fr) minmax(0, 1.8fr) auto;
      align-items: baseline;
      gap: 1.5rem;
      padding-block: 2rem;
    }
  }

  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .recognition-row--preview {
      cursor: default;
    }

    .award-preview {
      position: absolute;
      z-index: 3;
      top: 50%;
      right: 3.75rem;
      display: block;
      width: 7.5rem;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--text-heading) 20%, var(--border));
      border-radius: 0.5rem;
      background: var(--bg);
      box-shadow: 0 1rem 3rem color-mix(in srgb, var(--bg) 70%, transparent);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-46%) scale(0.96);
      transition:
        opacity 220ms ease,
        transform 320ms cubic-bezier(0.32, 0.72, 0, 1),
        visibility 220ms;
      visibility: hidden;
    }

    .award-preview figure {
      height: 100%;
      min-width: 0;
      overflow: hidden;
    }

    .award-preview--gallery {
      display: grid;
      grid-template-columns: 1fr 0.563fr 0.75fr;
      width: min(24rem, 34vw);
      aspect-ratio: 2.313 / 1;
      gap: 0.3rem;
      padding: 0.3rem;
    }

    .recognition-row--preview:hover .award-preview {
      opacity: 1;
      transform: translateY(-50%) scale(1);
      visibility: visible;
    }
  }

  /* Mobile / touch thumbnail strip — static, below text row */
  @media (max-width: 899px) {
    .award-preview {
      display: flex;
      position: static;
      grid-column: 1 / -1;
      width: 100%;
      height: 5rem;
      gap: 0.3rem;
      overflow: hidden;
      border-radius: 0.375rem;
    }

    .award-preview figure {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      border-radius: 0.25rem;
    }

    /* Gallery variant: render as flex strip, not grid tooltip */
    .award-preview--gallery {
      display: flex;
      width: 100%;
      aspect-ratio: unset;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .award-preview {
      transition: none;
    }
  }
</style>
