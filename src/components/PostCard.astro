---
import { Icon } from "astro-icon/components";

type Post = Awaited<ReturnType<typeof import("../lib/content").getSortedPosts>>[number];

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h3" } = Astro.props;

const wordCount = post.body?.split(/\s+/u).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.ceil(wordCount / 180));
const isMyanmar = /[\u1000-\u109F]/u.test(post.data.title);
const excerpt = post.data.description ?? post.data.summary;

const HeadingTag = headingLevel;
---

<a
  href={`/post/${post.id}`}
  class="group grid gap-7 border-b border-(--border) px-1 py-10 no-underline active:opacity-75 sm:grid-cols-12 sm:items-end"
>
  <div class="min-w-0 sm:col-span-9">
    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-(--text-faint)">
      <span>{post.data.categories.join(" / ")}</span>
      {isMyanmar && <><span aria-hidden="true">·</span><span>Burmese</span></>}
    </div>
    <HeadingTag class="mt-4 max-w-3xl font-serif text-3xl font-normal leading-[1.05] tracking-tight text-(--text-heading) transition-opacity duration-300 group-hover:opacity-65 sm:text-4xl">
      {post.data.title}
    </HeadingTag>
    {excerpt && (
      <p class="mt-4 max-w-2xl text-sm leading-6 text-(--text-muted) sm:text-[15px]">
        {excerpt}
      </p>
    )}
  </div>

  <div class="flex items-center justify-between gap-6 sm:col-span-3 sm:justify-end">
    <div class="flex flex-col gap-1 sm:items-end">
      <time datetime={post.data.publishedDate.toISOString()} class="font-mono text-xs tabular-nums text-(--text-muted)">
        {post.data.publishedDate.toLocaleDateString("en-US", {
          month: "short",
          day: "2-digit",
          year: "numeric",
        })}
      </time>
      <span class="font-mono text-[10px] text-(--text-faint)">{minutes} min read</span>
    </div>
    <div class="flex size-11 items-center justify-center rounded-full border border-(--border) text-(--text-heading) transition-[background-color,color,transform] duration-300 group-hover:-translate-y-0.5 group-hover:bg-(--text-heading) group-hover:text-(--bg)" aria-hidden="true">
      <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
    </div>
  </div>
</a>
