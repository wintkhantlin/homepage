---
import { Icon } from "astro-icon/components";

type Post = Awaited<ReturnType<typeof import("../lib/content").getSortedPosts>>[number];

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h3" } = Astro.props;

const wordCount = post.body?.split(/\s+/u).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.ceil(wordCount / 180));
const isMyanmar = /[က-႟]/u.test(post.data.title);
const excerpt = post.data.englishSummary ?? post.data.description ?? post.data.summary;
const categoryName = post.data.categories[0].replace(/-/gu, " ");
const category = categoryName.charAt(0).toUpperCase() + categoryName.slice(1);

const HeadingTag = headingLevel;
---

<article class="post-row">
  <a href={`/post/${post.id}`} class="post-link group">
    <time datetime={post.data.publishedDate.toISOString()} class="post-date text-sm tabular-nums">
      {post.data.publishedDate.toLocaleDateString("en-US", {
        month: "short",
        day: "2-digit",
        year: "numeric",
      })}
    </time>

    <div class="min-w-0">
      <HeadingTag lang={isMyanmar ? "my" : undefined} class="post-title text-xl font-semibold leading-snug tracking-[-0.02em] sm:text-2xl">
        {post.data.title}
      </HeadingTag>
      {excerpt && (
        <p lang={isMyanmar && !post.data.englishSummary ? "my" : undefined} class="mt-2 max-w-[60ch] text-base leading-relaxed text-(--text-muted)">
          {excerpt}
        </p>
      )}
    </div>

    <p class="post-meta text-sm">
      <span>{category}</span>
      <span class="text-(--text-faint)">{isMyanmar ? "Burmese · " : ""}{minutes} min read</span>
      <Icon name="lucide:arrow-right" class="post-arrow size-4" aria-hidden="true" />
    </p>
  </a>
</article>

<style>
  .post-row {
    border-bottom: 1px solid var(--border);
    padding-block: 0.25rem;
  }

  .post-link {
    display: grid;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding: 1.25rem 0.75rem;
    margin-inline: -0.75rem;
    color: var(--text-heading);
    transition: background-color 240ms ease;
  }

  .post-date {
    color: var(--text-faint);
  }

  .post-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 240ms ease;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    color: var(--text-muted);
  }

  .post-arrow {
    margin-left: auto;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-link:hover,
  .post-link:focus-visible {
    background: var(--surface);
  }

  .post-link:hover .post-title,
  .post-link:focus-visible .post-title {
    text-decoration-color: currentColor;
  }

  .post-link:hover .post-arrow,
  .post-link:focus-visible .post-arrow {
    transform: translateX(0.25rem);
  }

  @media (min-width: 768px) {
    .post-link {
      grid-template-columns: 7.5rem minmax(0, 1fr) 11rem;
      align-items: baseline;
      gap: 2rem;
      padding-block: 2rem;
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }

    .post-arrow {
      margin: 0.25rem 0 0;
    }
  }
</style>
