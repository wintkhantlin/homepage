---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/home/AboutSection.astro";
import profilePhoto from "../assets/img/happer.png";
import { getImage } from "astro:assets";
import { createBreadcrumbSchema, createPersonSchema, createProfilePageSchema, siteConfig } from "../lib/seo";

const profileImage = await getImage({ src: profilePhoto, width: 1200, height: 900, format: "webp" });
const title = `About ${siteConfig.name} | Backend Software Engineer`;
const description =
  "Wint Khant Lin, also known as Happer, is a college student and backend software engineer from Myanmar building distributed systems and writing in English and Burmese.";
const structuredData = [
  createProfilePageSchema(Astro.site),
  createPersonSchema(Astro.site, profileImage.src),
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "About", path: "/about" },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/about"
  image={profileImage.src}
  imageAlt="Wint Khant Lin, backend software engineer from Myanmar"
  type="profile"
  keywords={["about Wint Khant Lin", "Happer", "backend engineer Myanmar"]}
  structuredData={structuredData}
>
  <main id="main-content" class="mx-auto w-full max-w-7xl px-5 pb-24 pt-24 text-(--text) sm:px-6 md:px-8">
    <AboutSection level={1} />
  </main>
</BaseLayout>
