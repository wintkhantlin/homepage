---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import gustoMedals from "../../assets/img/awards/gusto-innovation-golden-metals.png";
import gustoProjectDisplay from "../../assets/img/awards/polo-gusto-innovation-1.jpeg";

interface Recognition {
  result: string;
  event: string;
  datetime: string;
  date: string;
}

const recognitions: Recognition[] = [
  {
    result: "Winner Nominee",
    event: "UXMM AI Ocean",
    datetime: "2026-11",
    date: "November 2026",
  },
  {
    result: "First runner-up",
    event: "GUSTO Innovation Awards & Forum 2026",
    datetime: "2026-08",
    date: "August 2026",
  },
  {
    result: "Winner",
    event: "Let's Tech 2026: Agentic Edition",
    datetime: "2026-07",
    date: "July 2026",
  },
  {
    result: "Winner",
    event: "GUSTO Technical Competition 2026",
    datetime: "2026-01",
    date: "January 2026",
  },
];

const photos = [
  {
    src: gustoProjectDisplay,
    alt: "The team's secured recommerce marketplace display at the GUSTO Innovation Awards & Forum",
    caption: "The team's recommerce marketplace display, GUSTO Innovation Awards & Forum, August 2026",
  },
  {
    src: gustoMedals,
    alt: "Two gold GUSTO College award medals held in one hand",
    caption: "Two gold medals from the GUSTO Innovation Awards & Forum, August 2026",
  },
];

const largePhotos = await Promise.all(
  photos.map(async (photo) => {
    const large = await getImage({ src: photo.src, width: 1400, format: "webp" });
    return { src: large.src, width: large.options.width, height: large.options.height, alt: photo.alt, caption: photo.caption };
  }),
);
---

<!-- Split: the results as a dated list beside two photographs from the GUSTO forum, neither of them of a person. The photos share the list's top and bottom edges. -->
<section id="recognition" aria-labelledby="recognition-heading" class="scroll-mt-[calc(var(--section-gap-l)*-1)] pt-(--section-gap-l)">
  <h2
    id="recognition-heading"
    class="text-section font-semibold leading-[1.02] tracking-[-0.04em] text-(--text-heading)"
  >
    Competition results
  </h2>

  <div class="recognition-split mt-10">
    <div class="recognition-ledger">
      <ol class="recognition-list">
        {recognitions.map((recognition) => (
          <li class="recognition-row">
            <p class="text-title font-semibold tracking-[-0.02em] text-(--text-heading)">{recognition.result}</p>
            <p class="recognition-event text-base leading-relaxed text-(--text-muted)">{recognition.event}</p>
            <time datetime={recognition.datetime} class="recognition-date text-sm tabular-nums text-(--text-faint)">
              {recognition.date}
            </time>
          </li>
        ))}
      </ol>
    </div>

    <div class="recognition-photos">
      <figure class="recognition-photo recognition-photo--lead">
        <a href={largePhotos[0].src} class="photo-open" data-photo-index="0" aria-label={`View larger: ${photos[0].alt}`}>
        <Image
          src={gustoProjectDisplay}
          alt="The team's secured recommerce marketplace display at the GUSTO Innovation Awards & Forum"
          width={700}
          widths={[400, 600, 700]}
          quality={70}
          sizes="(min-width: 1024px) 330px, min(57vw, 286px)"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        </a>
      </figure>
      <figure class="recognition-photo recognition-photo--second">
        <a href={largePhotos[1].src} class="photo-open" data-photo-index="1" aria-label={`View larger: ${photos[1].alt}`}>
        <Image
          src={gustoMedals}
          alt="Two gold GUSTO College award medals held in one hand"
          width={500}
          widths={[300, 400, 500]}
          quality={70}
          sizes="(min-width: 1024px) 245px, min(43vw, 215px)"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        </a>
      </figure>
    </div>

    <p class="recognition-caption text-sm text-(--text-faint)">GUSTO Innovation Awards & Forum, August 2026</p>
  </div>

  <!-- Opens over the page when scripting runs; without it, each photo link opens the full-size file. -->
  <dialog class="photo-viewer" aria-labelledby="photo-viewer-caption" data-photo-viewer data-photos={JSON.stringify(largePhotos)}>
    <figure class="photo-viewer-figure">
      <img class="photo-viewer-img" width={largePhotos[0].width} height={largePhotos[0].height} alt={largePhotos[0].alt} data-viewer-img />
      <figcaption id="photo-viewer-caption" class="text-sm text-(--text-muted)" data-viewer-caption>{largePhotos[0].caption}</figcaption>
    </figure>

    <div class="photo-viewer-controls">
      <p class="text-sm tabular-nums text-(--text-faint)" data-viewer-count>1 of {largePhotos.length}</p>
      <div class="flex items-center gap-1">
        <button type="button" class="viewer-button" data-viewer-prev>
          <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
          Previous
        </button>
        <button type="button" class="viewer-button" data-viewer-next>
          Next
          <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
        </button>
        <button type="button" class="viewer-button" data-viewer-close>
          <Icon name="lucide:x" class="size-4" aria-hidden="true" />
          Close
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  type Photo = { src: string; width: number; height: number; alt: string; caption: string };

  const viewer = document.querySelector<HTMLDialogElement>("[data-photo-viewer]");

  if (viewer && typeof viewer.showModal === "function") {
    const photos: Photo[] = JSON.parse(viewer.dataset.photos ?? "[]");
    const img = viewer.querySelector<HTMLImageElement>("[data-viewer-img]");
    const caption = viewer.querySelector<HTMLElement>("[data-viewer-caption]");
    const count = viewer.querySelector<HTMLElement>("[data-viewer-count]");
    const closeButton = viewer.querySelector<HTMLButtonElement>("[data-viewer-close]");
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + photos.length) % photos.length;
      const photo = photos[current];
      // The full-size file loads only when the viewer opens, so the page doesn't download it up front.
      if (img) {
        img.src = photo.src;
        img.width = photo.width;
        img.height = photo.height;
        img.alt = photo.alt;
      }
      if (caption) caption.textContent = photo.caption;
      if (count) count.textContent = `${current + 1} of ${photos.length}`;
    };

    for (const link of document.querySelectorAll<HTMLAnchorElement>(".photo-open")) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        opener = link;
        show(Number(link.dataset.photoIndex ?? 0));
        viewer.showModal();
        closeButton?.focus();
      });
    }

    viewer.querySelector("[data-viewer-prev]")?.addEventListener("click", () => show(current - 1));
    viewer.querySelector("[data-viewer-next]")?.addEventListener("click", () => show(current + 1));
    closeButton?.addEventListener("click", () => viewer.close());

    viewer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    viewer.addEventListener("close", () => opener?.focus());

    // A click on the backdrop lands on the dialog itself, never on its content.
    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });
  }
</script>

<style>
  .recognition-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.75rem;
  }

  .recognition-ledger {
    container-type: inline-size;
    margin-bottom: 2.25rem;
  }

  .recognition-list {
    border-top: 1px solid var(--border);
  }

  /* Result and date share the first line, with the event under them. */
  .recognition-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .recognition-event {
    grid-row: 2;
    grid-column: 1 / -1;
  }

  .recognition-date {
    grid-row: 1;
    grid-column: 2;
    text-align: right;
  }

  /* 4:3 columns over 3:4 and 9:16 photos give both the same height with nothing cropped. */
  .recognition-photos {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr);
    gap: 0.75rem;
    max-width: 32rem;
  }

  .recognition-photo {
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--surface);
    outline: 1px solid var(--border);
    outline-offset: -1px;
  }

  .recognition-photo :global(img) {
    border-radius: inherit;
  }

  .photo-open {
    display: block;
    height: 100%;
    border-radius: inherit;
    cursor: zoom-in;
  }

  .photo-open :global(img) {
    transition: opacity 200ms ease;
  }

  .photo-open:hover :global(img) {
    opacity: 0.86;
  }

  /* The figure clips its overflow, so the ring sits inside the photo. */
  .photo-open:focus-visible {
    outline-offset: -4px;
  }

  .photo-viewer {
    width: min(100% - 2rem, 56rem);
    max-width: none;
    max-height: calc(100% - 2rem);
    margin: auto;
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    padding: 1rem;
    background: var(--surface);
    color: var(--text);
  }

  .photo-viewer[open] {
    animation: viewer-in 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-viewer::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  .photo-viewer-figure {
    display: grid;
    gap: 0.75rem;
  }

  .photo-viewer-img {
    width: 100%;
    max-height: 70svh;
    border-radius: 0.5rem;
    background: var(--bg);
    object-fit: contain;
  }

  .photo-viewer-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }

  .viewer-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    padding-inline: 0.875rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .viewer-button:hover {
    background: var(--surface-raised);
    color: var(--text-heading);
  }

  .viewer-button:active {
    background: var(--bg);
  }

  @keyframes viewer-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  .recognition-photo--lead {
    aspect-ratio: 3 / 4;
  }

  .recognition-photo--second {
    aspect-ratio: 9 / 16;
  }

  /* One line per result once the list is wide enough to hold the longest event name. */
  @container (min-width: 40rem) {
    .recognition-list {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr) max-content;
      column-gap: 1.5rem;
    }

    .recognition-row {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      padding-block: 1.5rem;
    }

    .recognition-event,
    .recognition-date {
      grid-row: auto;
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .recognition-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }

    .recognition-ledger {
      margin-bottom: 0;
    }

    .recognition-photos {
      max-width: none;
    }

    /* The list sets the row's height and the photos fill it, so their edges meet its rules. */
    .recognition-photo--lead,
    .recognition-photo--second {
      position: relative;
      aspect-ratio: auto;
    }

    .photo-open {
      position: absolute;
      inset: 0;
    }

    .recognition-caption {
      grid-column: 2;
    }
  }

  @media (min-width: 1280px) {
    .recognition-split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
    }
  }
</style>
