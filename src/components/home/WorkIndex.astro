---
import { Image } from "astro:assets";

type Project = Awaited<
  ReturnType<typeof import("../../lib/content").getSortedProjects>
>[number];

interface Props {
  projects: Project[];
  /** Heads the list as a home section. Without it the page supplies its own h1 and the rows become h2s. */
  heading?: string;
}

const { projects, heading } = Astro.props as Props;
const ItemHeading = heading ? "h3" : "h2";

const contextLabels = {
  "open-source": "Open source",
  personal: "Personal project",
  hackathon: "Hackathon",
} as const;

const projectKind = (project: Project) => {
  const type = project.data.type;
  return type ? type.charAt(0).toUpperCase() + type.slice(1) : contextLabels[project.data.context];
};

const maturityLabels = {
  built: "Built",
  prototype: "Prototype",
  "work-in-progress": "Work in progress",
} as const;
---

<!-- The work as an index: each row names the project, what it proves, its stack and its year, with its screen always in view. -->
<section
  id="projects"
  aria-labelledby={heading ? "index-heading" : undefined}
  class:list={[heading && "scroll-mt-[calc(var(--section-gap-s)*-1)] pt-(--section-gap-s)"]}
>
  {heading && (
    <div class="index-head">
      <h2 id="index-heading" class="text-section font-semibold leading-[1.02] tracking-[-0.04em] text-(--text-heading)">
        {heading}
      </h2>
      {projects.length > 0 && (
        <a
          href="/projects"
          class="inline-flex min-h-11 w-fit items-center text-base font-semibold text-(--text-muted) underline decoration-(--border-strong) underline-offset-[0.3em] transition-colors duration-200 hover:text-(--text-heading) hover:decoration-(--text-heading)"
        >
          View all work
        </a>
      )}
    </div>
  )}

  {projects.length > 0 ? (
  <ul
    class="index-list"
    aria-labelledby={heading ? "index-heading" : undefined}
    aria-label={heading ? undefined : "All work"}
  >
    {projects.map((project, index) => (
      <li>
        <a
          href={`/project/${project.id}`}
          class="index-row"
          aria-labelledby={`index-name-${index}`}
          aria-describedby={`index-proof-${index} index-stack-${index}`}
        >
          <div class="index-name-cell">
            <ItemHeading id={`index-name-${index}`} class="index-name text-title font-semibold tracking-[-0.02em]">
              {project.data.name}
            </ItemHeading>
            <p class="mt-1 text-sm text-(--text-faint)">{projectKind(project)}</p>
          </div>

          <ul id={`index-proof-${index}`} class="index-proof grid gap-1 text-base text-(--text-heading)">
            {project.data.proofPoints.map((point) => <li>{point.title}</li>)}
          </ul>

          <p id={`index-stack-${index}`} class="index-stack text-base leading-relaxed text-(--text-muted)">
            <span class="sr-only">Built with </span>
            {project.data.technologies?.slice(0, 4).join(", ")}
          </p>

          <p class="index-year text-sm text-(--text-muted)">
            <span class="block tabular-nums text-(--text-heading)">{project.data.publishedDate.getFullYear()}</span>
            <span class="block">{maturityLabels[project.data.maturity]}</span>
          </p>

          <span class="index-thumb" aria-hidden="true" data-kind="product">
            <Image
              src={project.data.img}
              alt=""
              widths={[320, 640]}
              sizes="(min-width: 1024px) 240px, 100vw"
              loading="lazy"
              class="h-full w-full object-cover object-top"
            />
          </span>
        </a>
      </li>
    ))}
  </ul>
  ) : (
    <p class="border-t border-(--border) py-12 text-base leading-relaxed text-(--text-muted)">
      No project case studies are published yet. Check back soon.
    </p>
  )}
</section>

<style>
  .index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 2rem;
  }

  .index-list {
    border-top: 1px solid var(--border);
  }

  .index-list > li {
    border-bottom: 1px solid var(--border);
  }

  .index-row {
    display: grid;
    gap: 1rem;
    margin-inline: -0.75rem;
    border-radius: 0.5rem;
    padding: 1.5rem 0.75rem;
    color: var(--text-heading);
    transition: background-color 200ms ease;
  }

  .index-name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 200ms ease;
  }

  .index-thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--surface);
    outline: 1px solid var(--border);
    outline-offset: -1px;
  }

  .index-row:hover,
  .index-row:focus-visible {
    background: var(--surface);
  }

  .index-row:hover .index-name,
  .index-row:focus-visible .index-name {
    text-decoration-color: currentColor;
  }

  @media (min-width: 640px) {
    .index-row {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }

    .index-thumb {
      grid-column: 2;
      grid-row: 1 / span 4;
    }
  }

  @media (min-width: 1024px) {
    .index-row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 3fr) minmax(0, 3fr) minmax(0, 1.4fr) 15rem;
      align-items: center;
      column-gap: 2rem;
      padding-block: 1.75rem;
    }

    .index-thumb {
      grid-column: 5;
      grid-row: 1;
    }
  }
</style>
