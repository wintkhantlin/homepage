---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title="404 — Page Not Found | Wint Khant Lin"
  description="The requested page could not be found. Return to Wint Khant Lin's software engineering portfolio, projects, and programming notes."
  noindex={true}
>
  <main id="main-content" tabindex="-1" class="mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-5 pt-24 text-center sm:px-6 md:px-8">
    <p class="font-serif text-8xl font-normal tracking-[-0.035em] text-(--text-faint) md:text-[10rem]">
      404
    </p>

    <h1 class="mt-2 text-xl font-medium text-(--text-heading)">
      This page doesn't exist yet
    </h1>

    <p class="mt-3 max-w-md text-sm text-(--text-muted)">
      You might have followed an old link, or the page may have moved. Let's get you back on track.
    </p>

    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full bg-(--text-heading) px-5 text-sm font-semibold text-(--bg) transition-transform duration-300 hover:-translate-y-0.5 active:translate-y-0"
    >
      <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
      <span>Back to home</span>
    </a>
  </main>
</BaseLayout>
