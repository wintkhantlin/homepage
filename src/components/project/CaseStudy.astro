---
import { Icon } from "astro-icon/components";
import ProjectRail from "./ProjectRail.astro";

interface Props {
  challenge: string;
  approach: string;
  architecture: string[];
  highlights: string[];
  diagramLight: string;
  diagramDark: string;
  technologies?: string[];
  sections: { id: string; label: string }[];
}

const { challenge, approach, architecture, highlights, diagramLight, diagramDark, technologies, sections } = Astro.props as Props;

// The text sections share one column beside the rail; the diagram alone spans the page, so its labels stay legible.
const column = "md:col-span-8 md:col-start-5 lg:col-span-9 lg:col-start-4";
---

<div class="grid gap-y-20 md:grid-cols-12 md:gap-x-10">
  <ProjectRail
    class="md:col-span-4 md:col-start-1 md:row-span-5 md:row-start-1 lg:col-span-3 lg:col-start-1"
    technologies={technologies}
    sections={sections}
  />

  <section id="the-challenge" class:list={[column, "md:row-start-1"]}>
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      The challenge
    </h2>
    <p class="mt-6 max-w-[40rem] text-base leading-8 text-(--text-muted) sm:text-lg">
      {challenge}
    </p>
  </section>

  <section id="the-approach" class:list={[column, "md:row-start-2"]}>
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      The approach
    </h2>
    <p class="mt-6 max-w-[40rem] text-base leading-8 text-(--text-muted) sm:text-lg">
      {approach}
    </p>
  </section>

  <!-- Spans every column, over the rail's track: the rail slides under it and is back once the diagram has passed. -->
  <section id="system-architecture" class="relative z-10 bg-(--bg) md:col-span-12 md:col-start-1 md:row-start-3 md:grid md:grid-cols-subgrid">
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl md:col-span-8 md:col-start-5 lg:col-span-9 lg:col-start-4">
      System architecture
    </h2>
    <div
      class="diagram-frame mt-7 overscroll-x-contain overflow-x-auto rounded-2xl border border-(--border) bg-(--surface) p-4 sm:p-5 md:col-span-12"
      data-diagram
      tabindex="0"
      aria-label="Scrollable system architecture diagram"
    >
      <!-- Both themes ship as static SVG; CSS shows the one matching the active theme. -->
      <div class="diagram-theme diagram-dark min-w-168" role="img" aria-label="System architecture diagram" set:html={diagramDark}></div>
      <div class="diagram-theme diagram-light min-w-168" role="img" aria-label="System architecture diagram" set:html={diagramLight}></div>
    </div>

    <button
      type="button"
      class="-ml-3 mt-3 hidden md:col-span-12 min-h-11 cursor-pointer items-center gap-2 rounded-full px-3 text-sm font-medium text-(--text-muted) transition-[background-color,color] duration-200 hover:bg-(--surface-raised) hover:text-(--text-heading) active:bg-(--surface)"
      data-diagram-enlarge
    >
      <Icon name="lucide:maximize-2" class="size-4" aria-hidden="true" />
      Enlarge diagram
    </button>

    <dialog class="diagram-viewer" aria-label="System architecture diagram, enlarged" data-diagram-viewer>
      <div class="diagram-viewer-canvas" tabindex="0" aria-label="Scrollable system architecture diagram" data-diagram-canvas></div>
      <div class="mt-3 flex justify-end">
        <button type="button" class="viewer-button" data-diagram-close>
          <Icon name="lucide:x" class="size-4" aria-hidden="true" />
          Close
        </button>
      </div>
    </dialog>
  </section>

  <section id="how-it-is-structured" class:list={[column, "md:row-start-4"]}>
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      How it is structured
    </h2>
    <ol class="mt-7 border-t border-(--border)">
      {architecture.map((item, index) => (
        <li class="grid gap-4 border-b border-(--border) py-5 sm:grid-cols-[2rem_1fr]">
          <span class="font-mono text-xs text-(--text-faint)">{String(index + 1).padStart(2, "0")}</span>
          <span class="text-base leading-relaxed text-(--text-muted)">{item}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="what-it-includes" class:list={[column, "md:row-start-5"]}>
    <h2 class="text-3xl font-semibold tracking-[-0.03em] text-(--text-heading) sm:text-4xl">
      What it includes
    </h2>
    <ul class="mt-7 grid gap-px overflow-hidden rounded-xl border border-(--border) bg-(--border) sm:grid-cols-2">
      {highlights.map((item) => (
        <li class="bg-(--surface) p-6 text-base leading-relaxed text-(--text-muted)">{item}</li>
      ))}
    </ul>
    <slot />
  </section>
</div>

<script>
  const diagram = document.querySelector<HTMLElement>("[data-diagram]");
  const enlarge = document.querySelector<HTMLButtonElement>("[data-diagram-enlarge]");
  const viewer = document.querySelector<HTMLDialogElement>("[data-diagram-viewer]");
  const canvas = viewer?.querySelector<HTMLElement>("[data-diagram-canvas]");
  const closeViewer = viewer?.querySelector<HTMLButtonElement>("[data-diagram-close]");

  // Enlarging needs the viewer script, so the button stays hidden without JavaScript.
  enlarge?.classList.remove("hidden");
  enlarge?.classList.add("inline-flex");

  // The viewer shows a copy of the diagram variant for the active theme.
  enlarge?.addEventListener("click", () => {
    const theme = document.documentElement.classList.contains("light") ? "light" : "dark";
    const svg = diagram?.querySelector<SVGSVGElement>(`.diagram-${theme} svg`);
    if (!viewer || !canvas || !svg) return;
    const copy = svg.cloneNode(true) as SVGSVGElement;
    copy.style.maxWidth = "none";
    canvas.replaceChildren(copy);
    viewer.showModal();
    closeViewer?.focus();
  });

  closeViewer?.addEventListener("click", () => viewer?.close());

  // A click on the backdrop lands on the dialog itself, never on its content.
  viewer?.addEventListener("click", (event) => {
    if (event.target === viewer) viewer.close();
  });
</script>

<style>
  .diagram-theme {
    display: none;
  }

  .diagram-theme :global(svg) {
    display: block;
    margin-inline: auto;
  }

  /* Mermaid sets edge labels in the node text colour, which is the page colour here: invisible against it. */
  .diagram-theme :global(.edgeLabel text),
  .diagram-viewer-canvas :global(.edgeLabel text) {
    fill: var(--text-heading) !important;
  }

  .diagram-dark {
    display: block;
  }

  :global(.light) .diagram-dark {
    display: none;
  }

  :global(.light) .diagram-light {
    display: block;
  }

  .diagram-viewer {
    width: min(100% - 2rem, 88rem);
    max-width: none;
    max-height: calc(100% - 2rem);
    margin: auto;
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    padding: 1rem;
    background: var(--surface);
    color: var(--text);
  }

  .diagram-viewer::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  .diagram-viewer-canvas {
    overflow: auto;
    overscroll-behavior: contain;
    border-radius: 0.5rem;
  }

  /* Phones keep the diagram legible and scroll it sideways; larger screens fit the whole of it in view. */
  .diagram-viewer-canvas :global(svg) {
    display: block;
    width: 100%;
    min-width: 64rem;
    height: auto;
  }

  @media (min-width: 768px) {
    .diagram-viewer-canvas :global(svg) {
      min-width: 0;
      max-height: calc(100svh - 9rem);
    }
  }

  .viewer-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    padding-inline: 0.875rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .viewer-button:hover {
    background: var(--surface-raised);
    color: var(--text-heading);
  }

  .viewer-button:active {
    background: var(--bg);
  }
</style>
