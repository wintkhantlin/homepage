---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSortedPosts } from "../lib/content";
import PostCard from "../components/PostCard.astro";
import { absoluteUrl, createBreadcrumbSchema, siteConfig } from "../lib/seo";
import profilePhoto from "../assets/img/happer.png";
import { getImage } from "astro:assets";

const [posts, socialImage] = await Promise.all([
  getSortedPosts(),
  getImage({
    src: profilePhoto,
    width: 1200,
    height: 630,
    format: "webp",
  }),
]);

const title = `Software Engineering Notes & Articles | ${siteConfig.siteName}`;
const description =
  "Read programming notes from Wint Khant Lin on algorithms, systems thinking, software goals, and learning in public as a Myanmar developer.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Programming Writing",
    url: Astro.site ? new URL("/writing", Astro.site).toString() : "/writing",
    description,
    author: {
      "@type": "Person",
      "@id": absoluteUrl("/#person", Astro.site),
      name: siteConfig.author,
    },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: Astro.site
        ? new URL(`/post/${post.id}`, Astro.site).toString()
        : `/post/${post.id}`,
      datePublished: post.data.publishedDate.toISOString(),
    })),
  },
  createBreadcrumbSchema(
    [
      { name: "Home", path: "/" },
      { name: "Notes", path: "/writing" },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/writing"
  image={socialImage.src}
  imageAlt="Wint Khant Lin programming notes"
  keywords={["programming writing", "software engineering notes", "developer blog"]}
  structuredData={structuredData}
>
  <main id="main-content" class="mx-auto w-full max-w-7xl px-5 pb-24 pt-36 text-(--text) sm:px-6 md:px-8">
    <header class="border-b border-(--border) pb-12">
      <h1 class="font-sans text-[clamp(3rem,6.4vw,4.5rem)] font-semibold leading-none tracking-[-0.04em] text-(--text-heading)">
        Notes
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-(--text-muted)">
        Software, systems, and learning in public, in English and Burmese.
      </p>
    </header>

    <section class="flex flex-col" aria-label="All notes">
      {
        posts.length > 0 ? (
          posts.map((post) => <PostCard post={post} headingLevel="h2" />)
        ) : (
          <p class="py-12 text-base leading-relaxed text-(--text-muted)">
            No notes are published yet. Check back soon.
          </p>
        )
      }
    </section>
  </main>
</BaseLayout>
